#!/usr/bin/env bash

# Run mcpserver.py through dev.sh, then start the LocalMCP2 OpenAI tunnel.
# All arguments are passed to dev.sh before its `--` separator.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env"
TUNNEL_ALIAS="localmcp2"
TUNNEL_ID="tunnel_6ab0b44c148c8191ab70479ddbf9baca"
MCP_URL="http://127.0.0.1:2428/mcp2428"
MAX_POLL_AGE_SECONDS=90

status_line() {
  if [[ -t 2 ]]; then
    printf '%s\r\n' "$1" >&2
  else
    printf '%s\n' "$1" >&2
  fi
}

usage() {
  cat <<'EOF'
Usage: mcpserver [DEV.SH OPTIONS]

Run mcpserver.py in dev.sh, wait for it to become reachable, then start the
LocalMCP2 OpenAI tunnel. All options are passed to dev.sh as before.

Examples:
  mcpserver
  mcpserver -p ~/code/talks,~/Downloads,~/code:ro,~/r2:ro
  mcpserver -p ~/Downloads,~/Documents/data:ro

HTTP is stateless by default. For rollback/diagnosis:
  MCPSERVER_STATEFUL_HTTP=1 mcpserver ...
EOF
}

if [[ ${1-} == "-h" || ${1-} == "--help" ]]; then
  usage
  exit 0
fi

for arg in "$@"; do
  if [[ "$arg" == "--" ]]; then
    printf 'ERROR: pass only dev.sh options; mcpserver adds `-- mcpserver.py` itself\n' >&2
    exit 2
  fi
done

if ! command -v tunnel-client >/dev/null 2>&1; then
  printf 'ERROR: tunnel-client is not on PATH\n' >&2
  exit 1
fi

if ! command -v jaq >/dev/null 2>&1; then
  printf 'ERROR: jaq is required to inspect the tunnel runtime\n' >&2
  exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
  printf 'ERROR: curl is required to wait for the MCP server\n' >&2
  exit 1
fi

if [[ ! -r "$ENV_FILE" ]]; then
  printf 'ERROR: cannot read %s\n' "$ENV_FILE" >&2
  exit 1
fi

if ! (
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  [[ -n ${OPENAI_API_KEY_LOCALMCP2:-} ]]
); then
  printf 'ERROR: OPENAI_API_KEY_LOCALMCP2 is missing from %s\n' "$ENV_FILE" >&2
  exit 1
fi

if [[ ! -t 0 ]]; then
  printf 'ERROR: mcpserver must be started from an interactive terminal\n' >&2
  exit 1
fi

server_pid=""
tunnel_managed=false
cleanup() {
  if [[ "$tunnel_managed" == true ]]; then
    tunnel-client runtimes stop "$TUNNEL_ALIAS" --json >/dev/null 2>&1 || true
  fi
  [[ -z "$server_pid" ]] || kill "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

tunnel_is_healthy() {
  local status
  status="$(tunnel-client runtimes status "$TUNNEL_ALIAS" --json 2>/dev/null)" || return 1
  jaq -e --arg url "$MCP_URL" '
    .process_running == true
    and .ready == true
    and .process.target_kind == "server_url"
    and .process.target_value == $url
  ' <<<"$status" >/dev/null || return 1
  local health last_poll now
  health="$(tunnel-client health \
    --url-file "$HOME/.local/state/tunnel-client/health/$TUNNEL_ALIAS.url" \
    --require-control-plane-poll \
    --json 2>/dev/null)" || return 1
  jaq -e '.result == "ok"' <<<"$health" >/dev/null || return 1
  last_poll="$(jaq -r '.control_plane_poll.value | floor' <<<"$health")"
  now="$(date +%s)"
  ((last_poll > 0 && now - last_poll <= MAX_POLL_AGE_SECONDS))
}

# Start the MCP server first so an existing or new tunnel can reach it.
status_line "Starting MCP server at $MCP_URL..."
dev_args=(-v "$SCRIPT_DIR:$SCRIPT_DIR:ro")
if [[ -n "${MCPSERVER_STATEFUL_HTTP:-}" ]]; then
  dev_args+=(-e "MCPSERVER_STATEFUL_HTTP=$MCPSERVER_STATEFUL_HTTP")
fi
dev_args+=("$@")
"$SCRIPT_DIR/dev.sh" "${dev_args[@]}" -- "$SCRIPT_DIR/mcpserver.py" </dev/tty &
server_pid=$!

deadline=$((SECONDS + 10))
until curl --silent --output /dev/null --max-time 1 "$MCP_URL"; do
  if ! kill -0 "$server_pid" 2>/dev/null; then
    printf 'ERROR: MCP server exited before becoming reachable at %s\n' "$MCP_URL" >&2
    wait "$server_pid" || exit $?
    exit 1
  fi
  if ((SECONDS >= deadline)); then
    printf 'ERROR: MCP server did not start at %s within 10 seconds\n' "$MCP_URL" >&2
    exit 1
  fi
  sleep 0.1
done
if ! kill -0 "$server_pid" 2>/dev/null; then
  printf 'ERROR: MCP server exited while another process is answering at %s\n' "$MCP_URL" >&2
  wait "$server_pid" || exit $?
  exit 1
fi

if tunnel_is_healthy; then
  status_line "Reusing healthy OpenAI tunnel $TUNNEL_ALIAS..."
else
  if tunnel-client runtimes status "$TUNNEL_ALIAS" --json 2>/dev/null \
    | jaq -e '.process_running == true' >/dev/null; then
    status_line "Repairing OpenAI tunnel $TUNNEL_ALIAS..."
    tunnel-client runtimes stop "$TUNNEL_ALIAS" --json >/dev/null
  else
    status_line "Starting OpenAI tunnel $TUNNEL_ALIAS..."
  fi
  tunnel_managed=true
  (
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
    MCP_STARTUP_WAIT_TIMEOUT=10s tunnel-client runtimes connect \
      --alias "$TUNNEL_ALIAS" \
      --tunnel-id "$TUNNEL_ID" \
      --runtime-api-key env:OPENAI_API_KEY_LOCALMCP2 \
      --mcp-server-url "$MCP_URL" \
      --json >/dev/null
  )
fi
tunnel_managed=true

deadline=$((SECONDS + 45))
until tunnel_is_healthy; do
  if ! kill -0 "$server_pid" 2>/dev/null; then
    printf 'ERROR: MCP server exited while waiting for tunnel readiness\n' >&2
    wait "$server_pid" || exit $?
    exit 1
  fi
  if ((SECONDS >= deadline)); then
    printf 'ERROR: OpenAI tunnel did not become healthy within 45 seconds\n' >&2
    tunnel-client runtimes status "$TUNNEL_ALIAS" >&2 || true
    exit 1
  fi
  sleep 0.25
done

status_line "LocalMCP2 is ready at $MCP_URL"
wait "$server_pid"
