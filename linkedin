export function render(result, format = 'markdown', fields, context = {}) {
  if (format === 'md') format = 'markdown';
  if (Array.isArray(result.data)) result = { ...result, data: result.data.map(record => mask(record, fields)) };
  else if (result.data && fields) result = { ...result, data: mask(result.data, fields) };
  if (format === 'json') return JSON.stringify(result, null, 2) + '\n';
  if (format === 'ndjson') return [...(Array.isArray(result.data) ? result.data : [result.data]).filter(Boolean).map(record => JSON.stringify({ type: 'record', data: record })), JSON.stringify({ type: 'summary', ...result, data: undefined })].join('\n') + '\n';
  if(format==='text'){
    const records=(Array.isArray(result.data)?result.data:[result.data]).filter(Boolean);
    const warnings=[...new Set([...(result.warnings??[]),...records.flatMap(record=>record.warnings??[])])];
    return records.map(record=>`${record.name??record.author?.name??record.kind??''}\t${record.text??''}\t${record.url??record.id??''}`).join('\n\n')+(result.meta?.source?`\n\n_Source: ${result.meta.source}._`:'')+(result.coverage?.reason?`\n\n_Coverage: ${result.coverage.reason}._`:'')+(warnings.length?'\n\n'+warnings.map(warning=>'- '+warning).join('\n'):'')+'\n';
  }
  return renderMarkdown(result,{...context,selectedFields:fields});
}

