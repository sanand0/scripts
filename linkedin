/** Explicit DOM fallback for SDUI surfaces. Selectors come from the existing backup workflow. */
export function feedCards() {
  const cards = [...document.querySelectorAll('[componentkey^="update-card-focus"][role="listitem"], [data-urn][role="article"], .feed-shared-update-v2[data-urn]')];
  const records = [], missing = [];
