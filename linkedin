export function presentMarkdown(output,{stream=process.stdout,env=process.env}={}){
  if(!stream.isTTY){stream.write(output);return;}
  const config={input:output,stdio:['pipe','inherit','inherit'],env};
  let viewer=spawnSync('glow',['-p'],config);
  if(['ENOENT','EACCES'].includes(viewer.error?.code)){
    if(!env.PAGER?.trim()){stream.write(output);return;}
    viewer=spawnSync('/bin/sh',['-c','exec '+env.PAGER],config);
    if([126,127].includes(viewer.status)||['ENOENT','EACCES'].includes(viewer.error?.code)){stream.write(output);return;}
  }
  if(viewer.error)throw viewer.error;
  if(viewer.status&&viewer.status!==0)throw new Failure('PAGER_FAILED',`Markdown viewer exited with status ${viewer.status}`);
}

export function helpText(){return `LinkedIn CLI — live reads, automatic caching and offline search

${schema.usage.join('\n')}

Commands:
${Object.entries(schema.commands).map(([name,entry])=>'  '+[name,...entry.args.map(arg=>arg.toUpperCase())].join(' ').padEnd(28)+' '+entry.description).join('\n')}

Options: --db PATH --offline --refresh --limit N --page-size N --max-pages N
         --resume --fields id,text --format markdown|md (default)|json|ndjson|text
         --params JSON --since DATE_OR_PERIOD --until DATE_OR_PERIOD

Profile targets:
  Use me, a profile URL/URN/identifier, or a quoted name: linkedin activity "First Last"
  Names select the first accessible result in your personalized people search; the selection is shown.
  Bare single words remain identifiers; use name:Anand to search a single-word name.
  Applies to profile, activity and backup. Offline/resume reuses saved account-scoped resolutions.

People search filters (OR within a filter; AND across filters):
${Object.entries(schema.search_filters).map(([key,description])=>'  --'+key+': '+description).join('\n')}
  linkedin search people engineer --location "Chennai,Singapore" --organization Tata --degree 2
  All matching suggestions returned by LinkedIn are included, including aliases; this is a bounded suggestion list.
  Numeric IDs/URNs still work. --refresh updates name resolutions; offline/resume requires a saved lookup.

Own post analytics:
  linkedin analytics POST --refresh
  linkedin sync analytics me --since 7d --limit 20 --max-pages 5 [--resume]
  Metrics: likes (=all reactions), comments, reposts, impressions, saves, sends and accessible discovery metrics.
  Since is inclusive; until exclusive. mo=30 days, y=365 days. Date selection may use activity-ID times.

Scheduled posts and local paths:
  linkedin scheduled [--refresh|--offline]   # exact scheduled times (UTC) and full post text
  linkedin paths                          # script, backup/lock, SQLite/WAL/SHM, config and tests
  Scheduled posts are read only; refreshing replaces the cached active-list snapshot.
  No app config file is used: configuration comes from flags and environment variables.

Native backup (updates the existing blog-compatible JSONL):
  linkedin backup me --limit 100
  linkedin backup me --analytics --since 7d --limit 0
  linkedin export --schema backup --output archive.jsonl
  --archive PATH: default ~/Documents/data/linkedin-posts.jsonl; --file is an alias
  --no-comments: skip comment expansion; --limit 0: no explicit post limit
  --max-scrolls N (240), --max-comment-rounds N (30), --settle-ms N (800)
  --max-pages is an alias for the backup scroll limit. Rerun to retry incomplete work.
  --schema backup emits raw JSONL; default export includes all saved backup rows.
  --dry-run previews without browser access or cache/archive changes.

Output:
  Markdown is the default. In a terminal: glow -p, then $PAGER if glow is missing, otherwise raw Markdown.
  Pipes, --output files and structured formats bypass viewers. Post timestamps appear near the top.

Examples:
  linkedin profile "First Last" --format md
  linkedin find agents --offline --format json | jaq .data
  linkedin scheduled --output scheduled.md
Use --describe for the full machine-readable interface.
`;}

async function main() {
  try {
    const { result, options } = await run(process.argv.slice(2));
    if (options.values.help && !options.values.describe) {
      process.stdout.write(helpText());
      return;
    }
    const output = options.values.describe ? JSON.stringify(result, null, 2) + '\n' : options.archiveExport&&!options.values['dry-run']?result.data.map(row=>JSON.stringify(row)).join('\n')+(result.data.length?'\n':''):render(result, options.format, options.values.fields, options);
    if(options.archiveExport&&options.values['dry-run'])process.stdout.write(output);
    else if(options.archiveExport&&options.values.output)await writeBackupArchive(expand(options.values.output),result.data);
    else if (options.values.output) await writeFile(expand(options.values.output), output, { mode: 0o600 });
    else if(options.format==='markdown'&&!options.values.describe&&!options.archiveExport)presentMarkdown(output);
    else process.stdout.write(output);
  } catch (error) {
    const failure = envelope({ ok: false, error: { code: error.code ?? 'ERROR', message: error.message, retryable: error.retryable ?? false, retry_after: error.retryAfter, partial: error.partial } });
    process.stdout.write(JSON.stringify(failure) + '\n'); process.exitCode = 1;
  }
}
if (process.argv[1] && existsSync(process.argv[1]) && import.meta.url === pathToFileURL(realpathSync(process.argv[1])).href) await main();
