  for (const card of cards) {
    const permalink = card.querySelector('a[href*="/analytics/post-summary/"],a[href*="/feed/update/urn:li:activity:"]');
    let id = card.getAttribute('data-linkedin-cli-urn') ?? card.getAttribute('data-urn') ?? permalink?.href.match(/urn:li:activity:\d+/)?.[0];
    // SDUI card keys are session-local. The action menu is never clicked to obtain an id.
    if (!id) {
      const reaction = card.querySelector('button[aria-label^="Reaction button state:"]');
      let fiber = reaction && reaction[Object.keys(reaction).find(key => key.startsWith('__reactFiber'))];
      const seen = new WeakSet(), ids = new Set(); let visited = 0;
      function scan(value, depth = 0) {
        if (typeof value === 'string') { const match = value.match(/^reactionState-(urn:li:activity:\d+)$/); if (match) ids.add(match[1]); }
        else if (value && typeof value === 'object' && depth < 12 && visited++ < 3000 && !seen.has(value)) {
          seen.add(value); for (const [key, child] of Object.entries(value)) if (!['children', '_owner', 'return', 'stateNode'].includes(key)) scan(child, depth + 1);
        }
      }
      for (let i = 0; fiber && i < 25; i++, fiber = fiber.return) { scan(fiber.memoizedProps); if (fiber.stateNode === card) break; }
      if (ids.size === 1) id = [...ids][0];
    }
    if (!id) { missing.push('Card has no stable activity id'); continue; }
    const link = [...card.querySelectorAll('a[href*="/in/"],a[href*="/company/"]')].find(el => el.querySelector('p') && !el.closest('[data-sdui-anchor-id^="feed-header-"]'));
    const content = card.querySelector('[data-testid="expandable-text-box"], .update-components-update-v2__commentary, .feed-shared-update-v2__description-wrapper');
    const clone = content?.cloneNode(true);
    clone?.querySelectorAll('button').forEach(button => button.remove());
    clone?.querySelectorAll('br').forEach(br => br.replaceWith('\n'));
    const body = text(clone);
    const name = text(link?.querySelector('p [aria-hidden="true"],p') ?? card.querySelector('.update-components-actor__name')).replace(/\s*•.*$/s, '');
    records.push({ id, kind: 'post', url: `https://www.linkedin.com/feed/update/${id}/`, text: body,
      author: { name, url: link?.href.split('?')[0] }, source: 'dom-feed',
      textTruncated: Boolean(content?.querySelector('button')), media: [...card.querySelectorAll('img[src]')].filter(img => !/profile-|static\.licdn\.com/.test(img.src)).map(img => ({ kind: 'image', url: img.currentSrc || img.src, alt: img.alt })),
