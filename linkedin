export async function run(argv,dependencies={}){
  const response=await runCommand(argv,dependencies),{options}=response;
  if(!options.values.help&&!options.values.describe&&(options.resolvedFilters?.length||options.resolvedProfile))response.result={...response.result,meta:{...response.result.meta,...(options.resolvedFilters?.length?{resolved_filters:options.resolvedFilters}:{}),...(options.resolvedProfile?{resolved_profile:options.resolvedProfile}:{})}};
  return response;
}
