/** Read missing permalinks without touching the user's clipboard; used only in an owned tab. */
export async function resolveFeedLinks(maximum) {
  const selector = '[componentkey^="update-card-focus"][role="listitem"], [data-urn][role="article"], .feed-shared-update-v2[data-urn]';
  let resolved = 0, attempted = 0;
  for (const card of document.querySelectorAll(selector)) {
    if (attempted >= maximum) break;
    if (card.getAttribute('data-linkedin-cli-urn') || card.getAttribute('data-urn') || card.querySelector('a[href*="urn:li:activity:"]')) continue;
    const menu = card.querySelector('button[aria-label^="Open control menu"],button[aria-label^="More actions"]');
    if (!menu) continue;
    attempted++;
    card.scrollIntoView({ block: 'center' });
    menu.click();
    let label;
    for (let i = 0; i < 20 && !label; i++) {
      label = [...document.querySelectorAll('[role="menuitem"],p')].find(el => /^Copy link to post$/i.test(el.innerText?.trim()));
      if (!label) await new Promise(resolve => setTimeout(resolve, 50));
    }
    if (!label) { menu.click(); continue; }
    const clipboard = navigator.clipboard;
    const previous = Object.getOwnPropertyDescriptor(clipboard, 'writeText');
    let copied = '';
    Object.defineProperty(clipboard, 'writeText', { configurable: true, value: async value => { copied = value; } });
    try {
      label.click();
      for (let i = 0; i < 20 && !copied; i++) await new Promise(resolve => setTimeout(resolve, 50));
    } finally {
      if (previous) Object.defineProperty(clipboard, 'writeText', previous);
      else delete clipboard.writeText;
    }
    let url; try { url = new URL(copied); } catch { continue; }
    if (!['www.linkedin.com', 'linkedin.com'].includes(url.hostname)) continue;
    const id = decodeURIComponent(url.href).match(/urn:li:activity:\d+/)?.[0] ?? (url.pathname.match(/activity-(\d+)/)?.[1] ? 'urn:li:activity:' + url.pathname.match(/activity-(\d+)/)[1] : null);
    if (id) { card.setAttribute('data-linkedin-cli-urn', id); resolved++; }
  }
  return { attempted, resolved };
}

