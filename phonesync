def main(argv: list[str] | None = None) -> int:
    os.umask(0o077)
    argv = sys.argv[1:] if argv is None else argv
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command",
        nargs="?",
        default="sync",
        choices=[
            "sync",
            "probe",
            "status",
            "export",
            "restore-file",
            "verify",
            "migrate",
        ],
    )
    parser.add_argument("--describe", action="store_true")
    parser.add_argument(
        "--params", help="JSON options object; use --describe for names"
    )
    parser.add_argument(
        "--data-dir",
        type=Path,
        default=Path(os.environ["PHONESYNC_DIR"])
        if os.environ.get("PHONESYNC_DIR")
        else None,
    )
    parser.add_argument(
        "--legacy-db",
        type=Path,
        default=Path.home() / "Documents/data/phone/phonesync.sqlite3",
    )
    parser.add_argument("--inline-blobs", action="store_true")
    parser.add_argument("--serial", default=os.environ.get("ANDROID_SERIAL"))
    parser.add_argument("--sources")
    parser.add_argument(
        "--files",
        choices=["all", "inventory", "documents", "none"],
        default="inventory",
    )
    parser.add_argument("--attachments", action="store_true")
    parser.add_argument("--verify", action="store_true")
    parser.add_argument("--refresh-files", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--config", type=Path)
    parser.add_argument("--timeout", type=int, default=300)
    parser.add_argument("--source")
    parser.add_argument("--device")
    parser.add_argument("--sha256")
    parser.add_argument("--destination", type=Path)
    args = parser.parse_args(argv)
    if args.describe:
        print(canonical(describe()))
        return 0
    if args.params:
        params = json.loads(args.params)
        if not isinstance(params, dict):
            raise SyncError("--params requires a JSON object")
        actions = {
            a.dest: a
            for a in parser._actions
            if a.dest not in ("help", "params", "describe", "command")
        }
        if set(params) - actions.keys():
            raise SyncError(
                "Unknown --params options: " + ", ".join(set(params) - actions.keys())
            )
        for key, value in params.items():
            action = actions[key]
            if any(
                option == token or token.startswith(option + "=")
                for option in action.option_strings
                for token in argv
            ):
                continue
            expected = (
                bool
                if isinstance(action, argparse._StoreTrueAction)
                else int
                if action.type is int
                else str
            )
            if type(value) is not expected:
                raise SyncError(f"--params {key} must be {expected.__name__}")
            if action.choices and value not in action.choices:
                raise SyncError(f"--params {key} must be one of {action.choices}")
            setattr(args, key, action.type(value) if action.type else value)
    if args.timeout <= 0:
        raise SyncError("--timeout must be positive")
    args.data_dir = args.data_dir.expanduser().resolve() if args.data_dir else None
    args.legacy_db = args.legacy_db.expanduser().resolve()
    if args.command == "migrate":
        identity = legacy_device(args.legacy_db)
        if args.device and args.device != identity["device_id"]:
            raise SyncError("--device does not match legacy archive")
        root = args.data_dir or default_root(identity["device_id"])
        if args.dry_run:
            print(
                canonical(
                    {
                        "dry_run": True,
                        "legacy": str(args.legacy_db),
                        "directory": str(root),
                        "device": identity,
                    }
                )
            )
            return 0
        with archive_lock(root), archive_lock(args.legacy_db.parent, name=".lock"):
            result = migrate_sqlite(root, args.legacy_db, identity)
            write_archive_readme(root)
        print(canonical(result | {"directory": str(root)}))
        return 0
    if args.command in ("status", "export", "verify", "restore-file"):
        root = discover_root(args.data_dir, args.device)
        if not (root / "manifest.json").is_file():
            raise SyncError(
                f"No manifest archive at {root}; run phonesync or phonesync migrate first"
            )
        with archive_lock(root, name=".publish.lock", shared=True, blocking=True):
            archive = Archive(root)
            device = archive.manifest.get("device") or {}
            if args.device and device.get("device_id") != args.device:
                raise SyncError("--device does not match this archive")
            if args.command == "status":
                counts = [
                    {"source": source, **ref}
                    for source, ref in sorted(archive.manifest["sources"].items())
                ]
                print(
                    canonical(
                        {
                            "directory": str(root),
                            "format": 2,
                            "device": device,
                            "latest_run": archive.manifest.get("latest_run"),
                            "counts": counts,
                            "assets": len(archive.manifest["assets"]),
                        }
                    )
                )
            elif args.command == "verify":
                log("Verifying all published source records, histories and assets")
                print(canonical(verify_archive(archive) | {"directory": str(root)}))
            elif args.command == "export":
                if not args.source or args.source not in archive.manifest["sources"]:
                    raise SyncError(
                        "export requires an existing --source, e.g. phonesync export --source sms"
                    )
                for entry in archive.read_source(args.source).values():
                    data = (
                        archive.restore(entry["data"], typed_only=True)
                        if args.inline_blobs
                        else entry["data"]
                    )
                    print(canonical(data))
            else:
                if not args.sha256 or not args.destination:
                    raise SyncError("restore-file requires --sha256 and --destination")
                ref = archive.manifest["assets"].get(args.sha256)
                if ref is None:
                    raise SyncError("SHA256 is not referenced by this archive")
                path = archive_path(root, ref["$file"])
                if args.dry_run:
                    print(
                        canonical(
                            {
                                "dry_run": True,
                                "object": str(path),
                                "destination": str(args.destination),
                            }
                        )
                    )
                    return 0
                with path.open("rb") as source:
                    if hashlib.file_digest(source, "sha256").hexdigest() != args.sha256:
                        raise SyncError("Archived object failed SHA256 verification")
                    source.seek(0)
                    with args.destination.open("xb") as destination:
                        shutil.copyfileobj(source, destination)
                print(
                    canonical(
                        {"destination": str(args.destination), "sha256": args.sha256}
                    )
                )
        return 0
    providers = provider_config(args.config)
    sources = args.sources.split(",") if args.sources else list(providers)
    if len(set(sources)) != len(sources) or set(sources) - providers.keys():
        raise SyncError(
            "Unknown/duplicate sources; use --describe to list available providers"
        )
    log(f"phonesync {args.command}: {len(sources)} providers; files={args.files}")
    report, code = execute_sync(args, providers, sources)
    print(canonical(report))
    return code


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (
        SyncError,
        OSError,
        sqlite3.Error,
        subprocess.SubprocessError,
        ValueError,
    ) as exc:
        print(
            canonical({"status": "error", "error": str(exc)}),
            file=sys.stderr,
            flush=True,
        )
        raise SystemExit(1)
