class SyncError(Exception):
    """An actionable extraction, validation, or archive error."""


def log(message: str) -> None:
    print(message, file=sys.stderr, flush=True)


def canonical(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def default_root(device_id: str) -> Path:
    if not device_id or not device_id.replace("_", "").replace("-", "").isalnum():
        raise SyncError("Invalid device identity for archive path")
    return Path.home() / f"Documents/data/phone-{device_id}"


def now() -> str:
    return dt.datetime.now(dt.UTC).isoformat()


@contextlib.contextmanager
def archive_lock(
    root: Path,
    *,
    name: str = ".writer.lock",
    shared: bool = False,
    blocking: bool = False,
) -> Iterator[None]:
    """Hold an OS lock; a killed process releases it without stale lock cleanup."""
    existed = root.exists()
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not existed:
        fsync_directory(root.parent)
    with (root / name).open("a+b") as handle:
        try:
            if os.name == "nt":
                import msvcrt

                handle.write(b"\0")
                handle.flush()
                handle.seek(0)
                msvcrt.locking(
                    handle.fileno(), msvcrt.LK_LOCK if blocking else msvcrt.LK_NBLCK, 1
                )
            else:
                import fcntl

                fcntl.flock(
                    handle,
                    (fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
                    | (0 if blocking else fcntl.LOCK_NB),
                )
        except OSError as exc:
            raise SyncError(f"Another phonesync is using {root}") from exc
        yield


def decode_rows(
    lines: Iterable[str | bytes], summary: dict | None = None
) -> Iterator[dict]:
    """Require an explicit completion marker: truncated output is never empty data."""
    count = 0
    completed = False
    for line in lines:
        item = json.loads(line)
        if completed:
            raise SyncError("Unexpected data after helper completion marker")
        if "error" in item:
            raise SyncError(str(item["error"]))
        if "row" in item:
            if not isinstance(item["row"], dict):
                raise SyncError("Invalid helper row")
            count += 1
            yield item["row"]
        elif item.get("done") is True:
            if item.get("count") != count:
                raise SyncError("Helper row count does not match completion marker")
            completed = True
            if item.get("truncated"):
                raise SyncError("Helper returned a truncated inventory")
            if summary is not None:
                summary.update(item)
        elif "columns" not in item:
            raise SyncError("Unknown helper response")
    if not completed:
        raise SyncError("Helper output was truncated: no completion marker")


def valid_digest(value: str) -> bool:
    return (
        isinstance(value, str)
        and len(value) == 64
        and all(c in "0123456789abcdef" for c in value)
    )


def archive_path(root: Path, relative: str) -> Path:
    """Reject archive paths escaping the root, including through symlinks."""
    p = PurePosixPath(relative)
    if p.is_absolute() or ".." in p.parts or "\\" in relative:
        raise SyncError(f"Unsafe archive path: {relative!r}")
    result = (root / relative).resolve()
    if not result.is_relative_to(root.resolve()):
        raise SyncError(f"Archive path escapes root: {relative!r}")
    return result


def fsync_directory(path: Path) -> None:
    if os.name == "posix":
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


def durable_write(path: Path, data: bytes) -> None:
    """Replace one file durably; stage in its directory, on the same filesystem."""
    existed = path.parent.exists()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not existed:
        fsync_directory(path.parent.parent)
    fd, temporary = tempfile.mkstemp(prefix=".pending-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        Path(temporary).unlink(missing_ok=True)


class Assets:
    """Immutable, extension-correct files; one path per distinct byte payload."""

    def __init__(self, root: Path, refs: dict | None = None):
        self.root = root
        self.refs = dict(refs or {})

    def put_bytes(self, value: bytes, hint: str = "") -> dict:
        import io

        return self.put_file(io.BytesIO(value), hint)

    def put_file(self, handle: Any, hint: str = "") -> dict:
        self.root.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, temporary = tempfile.mkstemp(prefix=".asset-", dir=self.root)
        digest = hashlib.sha256()
        size, header = 0, b""
        try:
            with os.fdopen(fd, "wb") as output:
                while chunk := handle.read(1024 * 1024):
                    if not header:
                        header = chunk[:32]
                    output.write(chunk)
                    digest.update(chunk)
                    size += len(chunk)
                output.flush()
                os.fsync(output.fileno())
            sha = digest.hexdigest()
            ref = self.refs.get(sha)
            if ref is None:
                suffix = Path(hint).suffix.lower().lstrip(".")
                if not suffix.isascii() or not suffix.isalnum() or len(suffix) > 10:
                    suffix = "bin"
                folder = "files"
                for magic, extension in (
                    (b"\xff\xd8\xff", "jpg"),
                    (b"\x89PNG\r\n\x1a\n", "png"),
                    (b"GIF8", "gif"),
                    (b"BM", "bmp"),
                    (b"II*\x00", "tiff"),
                    (b"MM\x00*", "tiff"),
                ):
                    if header.startswith(magic):
                        folder, suffix = "images", extension
                        break
                if header[:4] == b"RIFF" and header[8:12] == b"WEBP":
                    folder, suffix = "images", "webp"
                if header[4:8] == b"ftyp" and header[8:12] in (
                    b"avif",
                    b"avis",
                    b"heic",
                    b"heix",
                    b"mif1",
                ):
                    folder, suffix = (
                        "images",
                        "avif" if header[8:12] in (b"avif", b"avis") else "heic",
                    )
                if header.startswith(b"%PDF-"):
                    suffix = "pdf"
                ref = {
                    "$file": f"{folder}/{sha}.{suffix}",
                    "sha256": sha,
                    "bytes": size,
                }
            path = archive_path(self.root, ref["$file"])
            intact = path.is_file() and path.stat().st_size == size
            if intact:
                with path.open("rb") as existing:
                    intact = hashlib.file_digest(existing, "sha256").hexdigest() == sha
            if not intact:
                path.parent.mkdir(exist_ok=True, mode=0o700)
                # A previous interrupted write may have created this directory.
                fsync_directory(self.root)
                os.replace(temporary, path)
                fsync_directory(path.parent)
            self.refs[sha] = ref
            return dict(ref)
        finally:
            Path(temporary).unlink(missing_ok=True)

    def read(self, ref: dict) -> bytes:
        raw = archive_path(self.root, ref["$file"]).read_bytes()
        if len(raw) != ref["bytes"] or hashlib.sha256(raw).hexdigest() != ref["sha256"]:
            raise SyncError(f"Asset failed integrity verification: {ref['$file']}")
        return raw


class Archive:
    """Stage a run in immutable JSONL files, then publish a single manifest.

    CLI readers hold a shared .publish.lock while pinning a manifest. Writers
    hold .writer.lock while staging, and .publish.lock only for commit/retirement.
    Unchanged sources retain the exact same file. Old source snapshots are
    removed after publication; distinct per-record history is inside each row.
    """

    def __init__(self, root: Path):
        self.root = root.resolve()
        path = self.root / "manifest.json"
        self._base = path.read_bytes() if path.exists() else None
        self.manifest = (
            json.loads(self._base)
            if self._base
            else {
                "format": 2,
                "schema_version": 2,
                "device": None,
                "sources": {},
                "assets": {},
                "runs": [],
            }
        )
        if self.manifest.get("format") != 2:
            raise SyncError("Unsupported archive format; upgrade phonesync")
        for ref in [
            *self.manifest.get("sources", {}).values(),
            *self.manifest.get("runs", []),
        ]:
            archive_path(self.root, ref["path"])
        for ref in self.manifest.get("assets", {}).values():
            archive_path(self.root, ref["$file"])
        self.assets = Assets(self.root, self.manifest.get("assets"))

    def externalize(self, value: Any) -> Any:
        if isinstance(value, dict) and set(value) == {"$blob_base64"}:
            return self.assets.put_bytes(
                base64.b64decode(value["$blob_base64"], validate=True)
            ) | {"$encoding": "base64"}
        if isinstance(value, dict):
            return {key: self.externalize(child) for key, child in value.items()}
        if isinstance(value, list):
            return [self.externalize(child) for child in value]
        return value

    def restore(self, value: Any, *, typed_only: bool = False) -> Any:
        if isinstance(value, dict) and "$file" in value:
            if typed_only and value.get("$encoding") != "base64":
                return dict(value)
            raw = self.assets.read(value)
            return (
                {"$blob_base64": base64.b64encode(raw).decode()}
                if value.get("$encoding") == "base64"
                else raw
            )
        if isinstance(value, dict):
            return {
                key: self.restore(child, typed_only=typed_only)
                for key, child in value.items()
            }
        if isinstance(value, list):
            return [self.restore(child, typed_only=typed_only) for child in value]
        return value

    def read_source(self, source: str) -> dict:
        ref = self.manifest["sources"].get(source)
        if ref is None:
            return {}
        digest, entries = hashlib.sha256(), {}
        with archive_path(self.root, ref["path"]).open("rb") as handle:
            for line in handle:
                digest.update(line)
                entry = json.loads(line)
                key = entry["_sync"]["id"]
                if not isinstance(key, str) or key in entries:
                    raise SyncError(f"Duplicate/invalid key in {source}")
                entries[key] = entry
        if len(entries) != ref["rows"] or digest.hexdigest() != ref["sha256"]:
            raise SyncError(f"Source integrity failure: {source}")
        return entries

    read_staged_source = read_source

    def write_source(self, source: str, entries: dict) -> dict:
        if not source.replace("_", "").isalnum():
            raise SyncError(f"Invalid source name: {source}")
        self.root.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, temporary = tempfile.mkstemp(prefix=".source-", dir=self.root)
        digest = hashlib.sha256()
        try:
            with os.fdopen(fd, "wb") as handle:
                for key in sorted(entries):
                    if key != entries[key]["_sync"]["id"]:
                        raise SyncError(f"Source key mismatch: {source}")
                    line = (canonical(entries[key]) + "\n").encode()
                    handle.write(line)
                    digest.update(line)
                handle.flush()
                os.fsync(handle.fileno())
            sha = digest.hexdigest()
            path = self.root / f"{source}--{sha}.jsonl"
            intact = path.is_file()
            if intact:
                with path.open("rb") as old:
                    intact = hashlib.file_digest(old, "sha256").hexdigest() == sha
            if not intact:
                os.replace(temporary, path)
                fsync_directory(self.root)
            ref = {
                "path": path.name,
                "sha256": sha,
                "rows": len(entries),
                "missing": sum(
                    row["_sync"]["missing_since"] is not None
                    for row in entries.values()
                ),
            }
            self.manifest["sources"][source] = ref
            return ref
        finally:
            Path(temporary).unlink(missing_ok=True)

    def update_source(
        self,
        source: str,
        key: str,
        rows: Iterable[dict],
        run: str,
        reconcile: bool = True,
    ) -> dict:
        entries = self.read_source(source)
        seen = set()
        result = {"total": 0, "added": 0, "changed": 0, "unchanged": 0, "missing": 0}
        for row in rows:
            if key not in row or row[key] is None:
                raise SyncError(f"{source}: required key {key!r} is missing")
            record_id = str(row[key])
            if record_id in seen:
                raise SyncError(f"{source}: duplicate record key {record_id!r}")
            seen.add(record_id)
            sha = hashlib.sha256(canonical(row).encode()).hexdigest()
            data = self.externalize(row)
            entry = entries.get(record_id)
            changed = entry is None or entry["_sync"]["sha256"] != sha
            result["total"] += 1
            result[
                "added" if entry is None else "changed" if changed else "unchanged"
            ] += 1
            if entry is None:
                entries[record_id] = {
                    "_sync": {
                        "id": record_id,
                        "sha256": sha,
                        "first_seen": run,
                        "last_changed": run,
                        "missing_since": None,
                    },
                    "data": data,
                    "history": [],
                    "changes": [{"run_id": run, "sha256": sha}],
                }
            else:
                meta = entry["_sync"]
                if changed:
                    history = {old["sha256"]: old for old in entry["history"]}
                    history[meta["sha256"]] = {
                        "sha256": meta["sha256"],
                        "data": entry["data"],
                    }
                    history.pop(sha, None)
                    entry["history"] = [history[h] for h in sorted(history)]
                    entry["changes"].append({"run_id": run, "sha256": sha})
                    meta["sha256"], meta["last_changed"] = sha, run
                meta["missing_since"] = None
                entry["data"] = data
        if reconcile:
            for record_id, entry in entries.items():
                if record_id not in seen and entry["_sync"]["missing_since"] is None:
                    entry["_sync"]["missing_since"] = run
                    result["missing"] += 1
        self.write_source(source, entries)
        return result

    def commit(self, report: dict) -> None:
        # Include only referenced assets, so a failed source cannot retain orphans.
        referenced = {}

        def collect(value):
            if isinstance(value, dict):
                if "$file" in value:
                    path = archive_path(self.root, value["$file"])
                    if not path.is_file() or path.stat().st_size != value["bytes"]:
                        raise SyncError(f"Missing/truncated asset: {value['$file']}")
                    referenced[value["sha256"]] = {
                        key: value[key] for key in ("$file", "sha256", "bytes")
                    }
                else:
                    for child in value.values():
                        collect(child)
            elif isinstance(value, list):
                for child in value:
                    collect(child)

        for source in self.manifest["sources"]:
            collect(self.read_source(source))
        self.manifest["assets"] = referenced
        self.assets.refs = dict(referenced)
        report_bytes = (
            json.dumps(report, ensure_ascii=False, indent=2) + "\n"
        ).encode()
        sha = hashlib.sha256(report_bytes).hexdigest()
        report_path = f"runs/{sha}.json"
        durable_write(archive_path(self.root, report_path), report_bytes)
        if not any(item["sha256"] == sha for item in self.manifest["runs"]):
            self.manifest["runs"].append(
                {"path": report_path, "sha256": sha, "run_id": report["run_id"]}
            )
        self.manifest["latest_run"] = report
        self.manifest["generation"] = report["run_id"]
        with archive_lock(self.root, name=".publish.lock", blocking=True):
            path = self.root / "manifest.json"
            current = path.read_bytes() if path.exists() else None
            if current != self._base:
                raise SyncError("Archive changed while staging; retry with one writer")
            data = (
                json.dumps(self.manifest, ensure_ascii=False, indent=2) + "\n"
            ).encode()
            durable_write(path, data)
            self._base = data
            self._retire_unreferenced()

    def _retire_unreferenced(self) -> None:
        # A killed process cannot run the temporary-file finally blocks. The
        # exclusive writer lock makes it safe to retire its abandoned staging.
        for folder in (
            self.root,
            self.root / "images",
            self.root / "files",
            self.root / "runs",
        ):
            if folder.exists():
                for prefix in (".source-", ".asset-", ".pending-"):
                    for path in folder.glob(prefix + "*"):
                        if path.is_file() or path.is_symlink():
                            path.unlink()
                fsync_directory(folder)
        keep = {ref["path"] for ref in self.manifest["sources"].values()}
        for path in self.root.glob("*--*.jsonl"):
            source, _, suffix = path.name.rpartition("--")
            if (
                source.replace("_", "").isalnum()
                and valid_digest(suffix.removesuffix(".jsonl"))
                and path.name not in keep
            ):
                path.unlink()
        keep_assets = {ref["$file"] for ref in self.manifest["assets"].values()}
        for folder in ("images", "files"):
            if not (self.root / folder).exists():
                continue
            for path in (self.root / folder).iterdir():
                if (
                    valid_digest(path.name.split(".", 1)[0])
                    and path.relative_to(self.root).as_posix() not in keep_assets
                ):
                    path.unlink()
            fsync_directory(self.root / folder)
        fsync_directory(self.root)


def object_path(root: Path, digest: str) -> Path:
    if not valid_digest(digest):
        raise SyncError("Invalid object SHA256")
    for folder in ("images", "files"):
        matches = list((root / folder).glob(f"{digest}.*"))
        if matches:
            return matches[0]
    raise SyncError(f"No asset with SHA256 {digest}")


class ADB:
    def __init__(self, serial: str | None, timeout: int):
        if not shutil.which("adb"):
            raise SyncError(
                "adb is missing. Install Android platform-tools and authorize USB debugging"
            )
        self.timeout = timeout
        self.serial = serial
        if not serial:
            output = subprocess.run(
                ["adb", "devices"], capture_output=True, text=True, check=True
            ).stdout
            devices = [
                line.split()[0]
                for line in output.splitlines()[1:]
                if line.strip() and line.split()[1] == "device"
            ]
            if len(devices) != 1:
                raise SyncError(
                    "Connect/unlock and authorize exactly one phone, or choose --serial (adb devices)"
                )
            self.serial = devices[0]
        self.prefix = ["adb", "-s", self.serial]
        if "shell_v2" not in self.run(["features"]).decode().splitlines():
            raise SyncError(
                "Phone/ADB must support shell_v2 for safe binary reads and remote error reporting"
            )
        self.helper = "/data/local/tmp/phonesync-" + uuid.uuid4().hex + ".dex"

    def run(
        self,
        args: list[str],
        *,
        output: Any = subprocess.PIPE,
        timeout: int | None = None,
    ) -> bytes:
        p = subprocess.run(
            self.prefix + args,
            stdout=output,
            stderr=subprocess.PIPE,
            timeout=timeout or self.timeout,
            check=False,
        )
        if p.returncode:
            raise SyncError(
                f"ADB failed ({p.returncode}): {p.stderr.decode(errors='replace')[-2000:]}"
            )
        return p.stdout or b""

    def shell(self, *args: str) -> str:
        return self.run(["shell", "-T", shlex.join(args)]).decode("utf-8").strip()

    def identity(self) -> dict:
        user = self.shell("am", "get-current-user")
        if user != "0":
            raise SyncError(
                f"Active Android user is {user}; only owner user 0 is supported. Switch to the owner profile"
            )
        android_id = self.shell(
            "settings", "--user", "0", "get", "secure", "android_id"
        )
        if not android_id or android_id == "null":
            raise SyncError(
                "Cannot establish phone identity: secure android_id unavailable"
            )
        serial = self.shell("getprop", "ro.serialno")
        if not serial:
            raise SyncError(
                "Cannot establish stable device serial; refusing to combine phones"
            )
        device = hashlib.sha256(f"{serial}\0{android_id}\00".encode()).hexdigest()[:24]
        return {
            "device_id": device,
            "serial": serial,
            "android_id": android_id,
            "user_id": 0,
            "model": self.shell("getprop", "ro.product.model"),
        }

    @contextlib.contextmanager
    def deployed(self) -> Iterator[None]:
        if not HELPER_DEX:
            raise SyncError("This copy of phonesync is missing its embedded helper")
        try:
            with tempfile.TemporaryDirectory(prefix="phonesync-") as temporary:
                path = Path(temporary) / "helper.dex"
                path.write_bytes(base64.b64decode(HELPER_DEX))
                self.run(["push", str(path), self.helper])
            self.shell("chmod", "444", self.helper)
            yield
        finally:
            try:
                self.shell("rm", "-f", self.helper)
            except (SyncError, subprocess.TimeoutExpired) as exc:
                log(f"Could not remove temporary helper {self.helper}: {exc}")

    def helper_args(self, *args: str) -> list[str]:
        if args[0] == "query":
            args = (*args, "0", "-", "-", "-", "0")
        elif args[0] == "files" or args[0] == "read":
            args = (*args, "0")
        command = [
            "app_process",
            "/system/bin",
            "com.sanand.phonesync.PhoneSyncQuery",
            *args,
        ]
        return [
            "shell",
            "-T",
            f"CLASSPATH={shlex.quote(self.helper)} " + shlex.join(command),
        ]

    def rows(self, *args: str) -> Iterator[dict]:
        # Spooling keeps memory bounded and lets adb finish before a DB transaction.
        with tempfile.TemporaryFile() as output:
            self.run(self.helper_args(*args), output=output)
            output.seek(0)
            self.last_summary = {}
            yield from decode_rows(output, self.last_summary)

    def provider_rows(self, uri: str) -> Iterator[dict]:
        if uri == "mms-addresses":
            for row in self.rows("mms-addresses", "0", "0"):
                row["key"] = f"{row['message_id']}:{row['_id']}"
                yield row
        else:
            yield from self.rows("query", uri)

    def read(self, uri: str, output: Any) -> None:
        self.run(self.helper_args("read", uri), output=output)


def tar_path(name: str) -> str:
    path = PurePosixPath(name)
    if (
        ".." in path.parts
        or path.is_absolute()
        or not path.parts
        or path.parts[0] != "sdcard"
    ):
        raise SyncError(f"Unexpected file in ADB tar stream: {name!r}")
    return "/" + str(path)


def sync_files(
    adb: ADB,
    archive: Archive,
    root: Path,
    device: str,
    run: str,
    rows: list[dict],
    mode: str,
    verify: bool,
    refresh: bool = False,
) -> dict:
    result = {"total": len(rows), "copied": 0, "unchanged": 0, "bytes": 0, "errors": []}
    if mode in ("inventory", "none"):
        return result | {"not_copied": len(rows)}
    old_files = archive.read_source("_files")
    pending = []
    for row in rows:
        path = row["path"]
        if mode == "documents" and not path.startswith(
            ("/sdcard/Documents/", "/sdcard/Recordings/", "/sdcard/Download/")
        ):
            result["not_copied"] = result.get("not_copied", 0) + 1
            continue
        entry = old_files.get(path)
        old = entry["data"] if entry else None
        asset = archive_path(root, old["asset"]["$file"]) if old else None
        intact = (
            asset is not None
            and asset.is_file()
            and asset.stat().st_size == old["size"]
        )
        if intact and verify:
            with asset.open("rb") as handle:
                intact = (
                    hashlib.file_digest(handle, "sha256").hexdigest()
                    == old["asset"]["sha256"]
                )
        if (
            not refresh
            and intact
            and (row["size"], row["mtime"]) == (old["size"], old["mtime"])
        ):
            result["unchanged"] += 1
        else:
            pending.append(row)
    log(f"Shared files: {len(pending)} to copy, {result['unchanged']} unchanged")
    required = sum(row["size"] for row in pending)
    if required + 256 * 1024 * 1024 > shutil.disk_usage(root).free:
        raise SyncError(
            f"Need up to {required} bytes plus 256 MiB free; choose --files inventory or documents"
        )
    for start in range(0, len(pending), 64):
        batch = pending[start : start + 64]
        expected = {r["path"]: r for r in batch}
        copied = []
        log(f"Copying files {start + 1}–{start + len(batch)} of {len(pending)}")
        command = shlex.join(["tar", "-c", "-f", "-", "--", *expected])
        with tempfile.TemporaryFile() as errors:
            process = subprocess.Popen(
                adb.prefix + ["shell", "-T", command],
                stdout=subprocess.PIPE,
                stderr=errors,
            )
            timer = threading.Timer(adb.timeout, process.kill)
            timer.daemon = True
            timer.start()
            try:
                with tarfile.open(fileobj=process.stdout, mode="r|") as stream:
                    for member in stream:
                        path = tar_path(member.name)
                        row = expected.pop(path, None)
                        if row is None or not member.isfile():
                            raise SyncError(f"Unexpected tar member: {member.name!r}")
                        if (
                            member.size != row["size"]
                            or int(member.mtime) != row["mtime"] // 1000
                        ):
                            result["errors"].append(
                                {
                                    "path": path,
                                    "error": "Changed after inventory; retry next run",
                                }
                            )
                            continue
                        with stream.extractfile(member) as handle:
                            ref = archive.assets.put_file(handle, hint=path)
                        if ref["bytes"] != row["size"]:
                            raise SyncError(f"Truncated file: {path}")
                        copied.append(
                            {
                                "path": path,
                                "size": row["size"],
                                "mtime": row["mtime"],
                                "asset": ref,
                            }
                        )
                code = process.wait(timeout=adb.timeout)
                errors.seek(0)
                if code:
                    raise SyncError(
                        f"tar exited {code}; batch not committed: "
                        + errors.read().decode(errors="replace")[-2000:]
                    )
                if copied:
                    archive.update_source(
                        "_files", "path", copied, run, reconcile=False
                    )
                    result["copied"] += len(copied)
                    result["bytes"] += sum(row["size"] for row in copied)
            except (tarfile.TarError, SyncError) as exc:
                result["errors"].append({"error": str(exc)})
            finally:
                timer.cancel()
                if process.poll() is None:
                    process.kill()
                    process.wait()
                process.stdout.close()
            result["errors"].extend(
                {"path": path, "error": "Not returned by tar; retry next run"}
                for path in expected
            )
    return result


def sync_attachments(
    adb: ADB,
    archive: Archive,
    root: Path,
    device: str,
    run: str,
    sources: list[str],
    verify: bool,
) -> dict:
    result = {"copied": 0, "unchanged": 0, "errors": []}
    cached = [entry["data"] for entry in archive.read_source("_attachments").values()]
    pending = []
    for source in ("mms_parts", "contacts"):
        if source not in sources:
            continue
        entries = archive.read_source(source)
        for index, (record_id, entry) in enumerate(entries.items()):
            if index % 100 == 0:
                log(f"Checking {source} attachments: {index}/{len(entries)}")
            if entry["_sync"]["missing_since"] is not None:
                continue
            row = entry["data"]
            if source == "mms_parts":
                if not row.get("_data"):
                    continue
                uri = f"content://mms/part/{record_id}"
            else:
                uri = row.get("photo_uri")
                if not uri:
                    continue
            matches = [
                item
                for item in cached
                if item["source"] == source
                and item["record_id"] == record_id
                and item["uri"] == uri
            ]
            old = max(matches, key=lambda item: item["run_id"], default=None)
            ref_path = archive_path(root, old["asset"]["$file"]) if old else None
            intact = (
                ref_path
                and ref_path.is_file()
                and ref_path.stat().st_size == old["asset"]["bytes"]
            )
            if (
                old
                and old.get("parent_changed") == entry["_sync"]["last_changed"]
                and intact
                and not verify
            ):
                result["unchanged"] += 1
                continue
            try:
                with tempfile.TemporaryFile() as handle:
                    adb.read(uri, handle)
                    handle.seek(0)
                    ref = archive.assets.put_file(handle, hint=row.get("name") or "")
                key = f"{source}:{record_id}:{uri}:{ref['sha256']}"
                pending.append(
                    {
                        "key": key,
                        "source": source,
                        "record_id": record_id,
                        "uri": uri,
                        "asset": ref,
                        "run_id": run,
                        "parent_changed": entry["_sync"]["last_changed"],
                    }
                )
                result["copied"] += 1
            except (SyncError, subprocess.TimeoutExpired) as exc:
                result["errors"].append(
                    {"source": source, "record_id": record_id, "error": str(exc)}
                )
    if pending:
        archive.update_source("_attachments", "key", pending, run, reconcile=False)
    return result


def provider_config(path: Path | None) -> dict:
    providers = dict(PROVIDERS)
    if path:
        config = json.loads(path.read_text())
        if not isinstance(config, dict) or set(config) - {"providers"}:
            raise SyncError("Config supports only a providers object")
        if not isinstance(config.get("providers", {}), dict):
            raise SyncError("Config providers must be an object")
        for name, value in config.get("providers", {}).items():
            if (
                not name.replace("_", "").isalnum()
                or not isinstance(value, dict)
                or set(value) != {"uri", "key"}
            ):
                raise SyncError(
                    "Provider must have a simple name and exactly uri/key fields"
                )
            if not isinstance(value["uri"], str) or not value["uri"].startswith(
                "content://"
            ):
                raise SyncError("Provider URI must start with content://")
            if not isinstance(value["key"], str) or not value["key"]:
                raise SyncError("Provider key must be a nonempty string")
            providers[name] = (value["uri"], value["key"])
    return providers


def migrate_sqlite(
    root: Path, legacy: Path, device: dict, *, retire: bool = True
) -> dict:
    """Verify and atomically convert a one-device SQLite archive."""
    root, legacy = root.expanduser().resolve(), legacy.expanduser().resolve()
    if not legacy.is_file():
        raise SyncError(f"Legacy archive not found: {legacy}")

    def sha_file(path: Path) -> str:
        with path.open("rb") as handle:
            return hashlib.file_digest(handle, "sha256").hexdigest()

    legacy_sha = sha_file(legacy)
    archive = Archive(root)
    marker = archive.manifest.get("migration")
    if marker:
        if (
            marker.get("legacy_path") != str(legacy)
            or marker.get("legacy_sha256") != legacy_sha
        ):
            raise SyncError("Target was migrated from a different SQLite archive")
        if not marker.get("verified") or archive.manifest.get("device", {}).get(
            "device_id"
        ) != device.get("device_id"):
            raise SyncError("Existing migration marker or device identity is invalid")
        db = sqlite3.connect(legacy.as_uri() + "?mode=ro", uri=True)
        try:
            if db.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
                raise SyncError("Legacy SQLite integrity check failed")
            _verify_legacy_migration(archive, db, device)
        finally:
            db.close()
        result = {
            "status": "already_migrated",
            "legacy_sha256": legacy_sha,
            "records": marker["records"],
            "assets": marker["assets"],
            "retired": False,
        }
        if retire:
            _retire_legacy_sqlite(legacy, marker.get("legacy_objects", []), legacy_sha)
            result["retired"] = True
        return result
    if archive.manifest.get("sources"):
        raise SyncError("Target JSONL archive already has sources; refusing to merge")

    db = sqlite3.connect(legacy.as_uri() + "?mode=ro", uri=True)
    try:
        if db.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
            raise SyncError("Legacy SQLite integrity check failed")
        db.execute("BEGIN")
        check_legacy_relations(db)
        device_rows = db.execute(
            "SELECT device_id,serial,android_id,user_id,model,first_seen,last_seen FROM devices"
        ).fetchall()
        if len(device_rows) != 1 or device_rows[0][0] != device.get("device_id"):
            raise SyncError("Legacy archive must contain exactly this phone")
        old_device = device_rows[0]
        for table in ("records", "versions", "files", "file_versions", "attachments"):
            foreign = db.execute(
                f"SELECT COUNT(*) FROM {table} WHERE device_id IS NULL OR device_id<>?",
                (device["device_id"],),
            ).fetchone()[0]
            if foreign:
                raise SyncError(f"Legacy {table} contains rows for another phone")
        for name, offset in (("serial", 1), ("android_id", 2), ("user_id", 3)):
            if device.get(name) is not None and old_device[offset] != device[name]:
                raise SyncError(f"Legacy {name} does not match this phone")

        runs = {}
        for rid, did, started, finished, status, report in db.execute(
            "SELECT run_id,device_id,started,finished,status,report FROM runs ORDER BY started,run_id"
        ):
            if did not in (None, device["device_id"]):
                raise SyncError("Legacy run belongs to another phone")
            runs[rid] = {
                "run_id": rid,
                "device_id": did,
                "started": started,
                "finished": finished,
                "status": status,
                "report": json.loads(report) if report else None,
                "sources": [],
            }
        for rid, source, status, report in db.execute(
            "SELECT run_id,source,status,report FROM source_runs ORDER BY run_id,source"
        ):
            if rid not in runs:
                raise SyncError(f"Legacy source run references unknown run {rid}")
            runs[rid]["sources"].append(
                {
                    "source": source,
                    "status": status,
                    "report": json.loads(report) if report else None,
                }
            )

        assets = {}

        def object_ref(digest: str, hint: str = "") -> dict:
            if digest in assets:
                return assets[digest]
            path = legacy.parent / "objects" / digest[:2] / digest[2:]
            if not path.is_file() or sha_file(path) != digest:
                raise SyncError(f"Legacy binary object missing/corrupt: {digest}")
            with path.open("rb") as handle:
                ref = archive.assets.put_file(handle, hint=hint)
            if ref.get("sha256") != digest:
                raise SyncError("Imported object failed SHA256 verification")
            assets[digest] = ref
            return ref

        def externalize(value):
            return archive.externalize(value)

        def decode(data: str, digest: str) -> dict:
            value = json.loads(data)
            if (
                canonical(value) != data
                or hashlib.sha256(data.encode()).hexdigest() != digest
            ):
                raise SyncError(
                    "Legacy JSON payload failed canonical SHA256 validation"
                )
            return value

        counts = {}
        sources = [
            r[0]
            for r in db.execute(
                "SELECT DISTINCT source FROM records WHERE device_id=? ORDER BY source",
                (device["device_id"],),
            )
        ]
        for source in sources:
            entries = {}
            for rid, data, digest, first, changed, missing in db.execute(
                "SELECT record_id,data,sha256,first_seen,last_changed,missing_since FROM records "
                "WHERE device_id=? AND source=? ORDER BY record_id",
                (device["device_id"], source),
            ):
                current = decode(data, digest)
                states = []
                for vrid, vdata, vsha in db.execute(
                    "SELECT run_id,data,sha256 FROM versions WHERE device_id=? AND source=? AND record_id=? ORDER BY run_id",
                    (device["device_id"], source, rid),
                ):
                    if vrid not in runs:
                        raise SyncError(
                            f"Legacy version references unknown run: {vrid}"
                        )
                    states.append((vrid, vsha, decode(vdata, vsha)))
                if not states or states[-1][1] != digest:
                    raise SyncError(
                        f"Current row disagrees with history: {source}/{rid}"
                    )
                history, changes = {}, []
                for vrid, vsha, value in states:
                    changes.append({"run_id": vrid, "sha256": vsha})
                    if vsha != digest and vsha not in history:
                        history[vsha] = {"sha256": vsha, "data": externalize(value)}
                key = str(rid)
                entries[key] = {
                    "_sync": {
                        "id": key,
                        "first_seen": first,
                        "last_changed": changed,
                        "missing_since": missing,
                        "sha256": digest,
                    },
                    "data": externalize(current),
                    "history": list(history.values()),
                    "changes": changes,
                }
            archive.write_source(source, entries)
            staged = archive.read_staged_source(source)
            if set(staged) != set(entries):
                raise SyncError(f"Staged row count mismatch in {source}")
            for key, entry in entries.items():
                raw, digest = db.execute(
                    "SELECT data,sha256 FROM records WHERE device_id=? AND source=? AND record_id=?",
                    (device["device_id"], source, key),
                ).fetchone()
                if staged[key] != entry or canonical(
                    archive.restore(entry["data"])
                ) != canonical(decode(raw, digest)):
                    raise SyncError(f"Staged row verification failed: {source}/{key}")
            counts[source] = len(entries)

        files = {}
        for path, size, mtime, digest, first, changed in db.execute(
            "SELECT path,size,mtime,sha256,first_seen,last_changed FROM files WHERE device_id=? ORDER BY path",
            (device["device_id"],),
        ):
            ref = object_ref(digest, path)
            file_data = {"path": path, "size": size, "mtime": mtime, "asset": ref}
            file_sha = hashlib.sha256(canonical(file_data).encode()).hexdigest()
            history, changes = {}, []
            for rid, old_size, old_mtime, old_sha in db.execute(
                "SELECT run_id,size,mtime,sha256 FROM file_versions WHERE device_id=? AND path=? ORDER BY run_id",
                (device["device_id"], path),
            ):
                if rid not in runs:
                    raise SyncError(f"File version references unknown run: {rid}")
                old_ref = object_ref(old_sha, path)
                old_data = {
                    "path": path,
                    "size": old_size,
                    "mtime": old_mtime,
                    "asset": old_ref,
                }
                old_record_sha = hashlib.sha256(
                    canonical(old_data).encode()
                ).hexdigest()
                changes.append({"run_id": rid, "sha256": old_record_sha})
                if old_record_sha != file_sha and old_record_sha not in history:
                    history[old_record_sha] = {
                        "sha256": old_record_sha,
                        "data": old_data,
                    }
            files[path] = {
                "_sync": {
                    "id": path,
                    "first_seen": first,
                    "last_changed": changed,
                    "missing_since": None,
                    "sha256": file_sha,
                },
                "data": file_data,
                "history": list(history.values()),
                "changes": changes,
            }
        if files:
            archive.write_source("_files", files)
            counts["_files"] = len(files)

        attachments = {}
        for source, rid, uri, digest, rid_run in db.execute(
            "SELECT source,record_id,uri,sha256,run_id FROM attachments WHERE device_id=? ORDER BY source,record_id,run_id,sha256",
            (device["device_id"],),
        ):
            if rid_run not in runs:
                raise SyncError(f"Attachment references unknown run: {rid_run}")
            ref = object_ref(digest)
            parent_changed = db.execute(
                "SELECT last_changed FROM records WHERE device_id=? AND source=? AND record_id=?",
                (device["device_id"], source, rid),
            ).fetchone()
            key = f"{source}:{rid}:{uri}:{digest}"
            attachment_data = {
                "key": key,
                "source": source,
                "record_id": rid,
                "uri": uri,
                "run_id": rid_run,
                "parent_changed": parent_changed[0] if parent_changed else None,
                "asset": ref,
            }
            attachment_sha = hashlib.sha256(
                canonical(attachment_data).encode()
            ).hexdigest()
            attachments[key] = {
                "_sync": {
                    "id": key,
                    "first_seen": rid_run,
                    "last_changed": rid_run,
                    "missing_since": None,
                    "sha256": attachment_sha,
                },
                "data": attachment_data,
                "history": [],
                "changes": [{"run_id": rid_run, "sha256": attachment_sha}],
            }
        if attachments:
            archive.write_source("_attachments", attachments)
            counts["_attachments"] = len(attachments)

        assets = dict(archive.assets.refs)
        archive.manifest.update(
            format=2,
            schema_version=2,
            device=dict(device),
            legacy_device=dict(
                zip(
                    (
                        "device_id",
                        "serial",
                        "android_id",
                        "user_id",
                        "model",
                        "first_seen",
                        "last_seen",
                    ),
                    old_device,
                )
            ),
            legacy_runs=list(runs.values()),
            migration={
                "legacy_path": str(legacy),
                "legacy_sha256": legacy_sha,
                "records": counts,
                "assets": len(assets),
                "verified": True,
                "legacy_objects": sorted(
                    digest
                    for digest in assets
                    if (legacy.parent / "objects" / digest[:2] / digest[2:]).is_file()
                ),
            },
        )
        migration_id = "migration-" + uuid.uuid4().hex
        archive.commit(
            {
                "run_id": migration_id,
                "status": "ok",
                "migration": "sqlite_to_jsonl",
                "legacy_sha256": legacy_sha,
                "records": counts,
                "assets": len(assets),
            }
        )

        reopened = Archive(root)
        if reopened.manifest.get("migration", {}).get("legacy_sha256") != legacy_sha:
            raise SyncError("Migration marker did not survive reopening")
        _verify_legacy_migration(reopened, db, device)
        for digest, ref in reopened.manifest.get("assets", {}).items():
            path = root / ref["$file"]
            if (
                not path.is_file()
                or path.stat().st_size != ref["bytes"]
                or sha_file(path) != digest
            ):
                raise SyncError(f"Committed object failed verification: {digest}")
        result = {
            "status": "migrated",
            "legacy_sha256": legacy_sha,
            "records": counts,
            "assets": len(assets),
            "retired": False,
        }
        if retire:
            db.close()
            _retire_legacy_sqlite(
                legacy, archive.manifest["migration"]["legacy_objects"], legacy_sha
            )
            result["retired"] = True
        return result
    finally:
        db.close()


def check_legacy_relations(db: sqlite3.Connection) -> None:
    for versions, current, keys in (
        ("versions", "records", ("device_id", "source", "record_id")),
        ("file_versions", "files", ("device_id", "path")),
    ):
        join = " AND ".join(f"c.{key}=v.{key}" for key in keys)
        if db.execute(
            f"SELECT 1 FROM {versions} v WHERE NOT EXISTS (SELECT 1 FROM {current} c WHERE {join}) LIMIT 1"
        ).fetchone():
            raise SyncError(
                f"Legacy {versions} contains history without a current record; preserving SQLite"
            )


def _verify_legacy_migration(
    archive: Archive, db: sqlite3.Connection, device: dict
) -> None:
    """Compare every migrated record, version, timeline, file, and attachment."""
    check_legacy_relations(db)
    sources = [
        r[0]
        for r in db.execute(
            "SELECT DISTINCT source FROM records WHERE device_id=? ORDER BY source",
            (device["device_id"],),
        )
    ]
    expected_sources = set(sources)
    if db.execute(
        "SELECT COUNT(*) FROM files WHERE device_id=?", (device["device_id"],)
    ).fetchone()[0]:
        expected_sources.add("_files")
    if db.execute(
        "SELECT COUNT(*) FROM attachments WHERE device_id=?", (device["device_id"],)
    ).fetchone()[0]:
        expected_sources.add("_attachments")
    if set(archive.manifest.get("sources", {})) != expected_sources:
        raise SyncError("Migrated source inventory does not match legacy SQLite")
    if (
        len(archive.manifest.get("legacy_runs", []))
        != db.execute("SELECT COUNT(*) FROM runs").fetchone()[0]
    ):
        raise SyncError("Migrated run inventory count mismatch")
    preserved_runs = {
        run["run_id"]: run for run in archive.manifest.get("legacy_runs", [])
    }
    for run_id, device_id, started, finished, status, report in db.execute(
        "SELECT run_id,device_id,started,finished,status,report FROM runs"
    ):
        saved = preserved_runs.get(run_id)
        if (
            not saved
            or saved.get("device_id") != device_id
            or saved.get("started") != started
            or saved.get("finished") != finished
            or saved.get("status") != status
            or saved.get("report") != (json.loads(report) if report else None)
        ):
            raise SyncError(f"Migrated run metadata mismatch: {run_id}")
    saved_source_runs = {
        (run["run_id"], source["source"]): source
        for run in archive.manifest.get("legacy_runs", [])
        for source in run.get("sources", [])
    }
    source_run_rows = db.execute(
        "SELECT run_id,source,status,report FROM source_runs"
    ).fetchall()
    if len(saved_source_runs) != len(source_run_rows):
        raise SyncError("Migrated source-run inventory count mismatch")
    for run_id, source, status, report in source_run_rows:
        saved = saved_source_runs.get((run_id, source))
        if (
            not saved
            or saved.get("status") != status
            or saved.get("report") != (json.loads(report) if report else None)
        ):
            raise SyncError(f"Migrated source-run metadata mismatch: {run_id}/{source}")

    for source in sources:
        entries = archive.read_source(source)
        rows = db.execute(
            "SELECT record_id,data,sha256,first_seen,last_changed,missing_since FROM records "
            "WHERE device_id=? AND source=? ORDER BY record_id",
            (device["device_id"], source),
        ).fetchall()
        if len(entries) != len(rows):
            raise SyncError(f"Migrated count mismatch: {source}")
        for rid, raw, digest, first, changed, missing in rows:
            key = str(rid)
            entry = entries.get(key)
            value = json.loads(raw)
            if (
                not entry
                or canonical(archive.restore(entry["data"])) != canonical(value)
                or entry["_sync"]
                != {
                    "id": key,
                    "first_seen": first,
                    "last_changed": changed,
                    "missing_since": missing,
                    "sha256": digest,
                }
            ):
                raise SyncError(f"Migrated record mismatch: {source}/{key}")
            states = db.execute(
                "SELECT run_id,data,sha256 FROM versions WHERE device_id=? AND source=? AND record_id=? ORDER BY run_id",
                (device["device_id"], source, rid),
            ).fetchall()
            if entry["changes"] != [
                {"run_id": run_id, "sha256": sha} for run_id, _, sha in states
            ]:
                raise SyncError(f"Migrated timeline mismatch: {source}/{key}")
            old = {item["sha256"]: item["data"] for item in entry["history"]}
            for _, state_raw, state_sha in states:
                state_value = json.loads(state_raw)
                candidate = entry["data"] if state_sha == digest else old.get(state_sha)
                if candidate is None or canonical(
                    archive.restore(candidate)
                ) != canonical(state_value):
                    raise SyncError(
                        f"Migrated history mismatch: {source}/{key}/{state_sha}"
                    )
    record_version_count = sum(
        db.execute(
            "SELECT COUNT(*) FROM versions WHERE device_id=? AND source=?",
            (device["device_id"], source),
        ).fetchone()[0]
        for source in sources
    )
    if (
        record_version_count
        != db.execute(
            "SELECT COUNT(*) FROM versions WHERE device_id=?", (device["device_id"],)
        ).fetchone()[0]
    ):
        raise SyncError("Legacy version rows do not map to migrated records")

    file_entries = archive.read_source("_files") if "_files" in expected_sources else {}
    for path, size, mtime, digest, first, changed in db.execute(
        "SELECT path,size,mtime,sha256,first_seen,last_changed FROM files WHERE device_id=? ORDER BY path",
        (device["device_id"],),
    ):
        entry = file_entries.get(path)
        if (
            not entry
            or entry["data"].get("path") != path
            or entry["data"].get("size") != size
            or entry["data"].get("mtime") != mtime
        ):
            raise SyncError(f"Migrated file metadata mismatch: {path}")
        ref = entry["data"]["asset"]
        if ref["sha256"] != digest or len(archive.restore(ref)) != size:
            raise SyncError(f"Migrated file asset mismatch: {path}")
        if (
            entry["_sync"]["first_seen"] != first
            or entry["_sync"]["last_changed"] != changed
        ):
            raise SyncError(f"Migrated file tracking mismatch: {path}")
        file_states = db.execute(
            "SELECT run_id,size,mtime,sha256 FROM file_versions WHERE device_id=? AND path=? ORDER BY run_id",
            (device["device_id"], path),
        ).fetchall()
        if len(entry["changes"]) != len(file_states):
            raise SyncError(f"Migrated file timeline mismatch: {path}")
        old_file_data = {state["sha256"]: state["data"] for state in entry["history"]}
        for change, (run_id, old_size, old_mtime, old_digest) in zip(
            entry["changes"], file_states
        ):
            old_data = (
                entry["data"]
                if change["sha256"] == entry["_sync"]["sha256"]
                else old_file_data.get(change["sha256"])
            )
            if change["run_id"] != run_id or old_data is None:
                raise SyncError(f"Migrated file history mismatch: {path}/{run_id}")
            old_ref = old_data["asset"]
            if (
                old_ref["sha256"] != old_digest
                or old_data["size"] != old_size
                or old_data["mtime"] != old_mtime
            ):
                raise SyncError(
                    f"Migrated file history metadata mismatch: {path}/{run_id}"
                )
    if (
        sum(
            db.execute(
                "SELECT COUNT(*) FROM file_versions WHERE device_id=? AND path=?",
                (device["device_id"], path),
            ).fetchone()[0]
            for (path,) in db.execute(
                "SELECT path FROM files WHERE device_id=?", (device["device_id"],)
            )
        )
        != db.execute(
            "SELECT COUNT(*) FROM file_versions WHERE device_id=?",
            (device["device_id"],),
        ).fetchone()[0]
    ):
        raise SyncError("Legacy file-version rows do not map to migrated files")
    if (
        len(file_entries)
        != db.execute(
            "SELECT COUNT(*) FROM files WHERE device_id=?", (device["device_id"],)
        ).fetchone()[0]
    ):
        raise SyncError("Migrated file inventory count mismatch")

    attachment_entries = (
        archive.read_source("_attachments")
        if "_attachments" in expected_sources
        else {}
    )
    attachment_rows = db.execute(
        "SELECT source,record_id,uri,sha256,run_id FROM attachments WHERE device_id=? ORDER BY source,record_id,run_id,sha256",
        (device["device_id"],),
    ).fetchall()
    if len(attachment_entries) != len(attachment_rows):
        raise SyncError("Migrated attachment inventory count mismatch")
    for source, rid, uri, digest, run_id in attachment_rows:
        key = f"{source}:{rid}:{uri}:{digest}"
        entry = attachment_entries.get(key)
        if (
            not entry
            or entry["data"].get("source") != source
            or entry["data"].get("record_id") != rid
            or entry["data"].get("uri") != uri
            or entry["data"].get("run_id") != run_id
            or entry["data"].get("key") != key
            or entry["data"].get("asset", {}).get("sha256") != digest
            or hashlib.sha256(canonical(entry["data"]).encode()).hexdigest()
            != entry["_sync"]["sha256"]
        ):
            raise SyncError(f"Migrated attachment mismatch: {key}")


def _retire_legacy_sqlite(legacy: Path, objects: list[str], expected_sha: str) -> None:
    if not legacy.exists():
        return
    for suffix in ("-wal", "-journal"):
        sidecar = Path(str(legacy) + suffix)
        if sidecar.exists() and sidecar.stat().st_size:
            raise SyncError(
                f"Refusing to retire SQLite with nonempty sidecar: {sidecar.name}"
            )
    with legacy.open("rb") as handle:
        if hashlib.file_digest(handle, "sha256").hexdigest() != expected_sha:
            raise SyncError("Legacy SQLite changed during migration; keeping it")
    # Only old objects named by verified migrated rows are eligible for removal.
    for digest in objects:
        path = legacy.parent / "objects" / digest[:2] / digest[2:]
        if path.is_file():
            with path.open("rb") as handle:
                if hashlib.file_digest(handle, "sha256").hexdigest() == digest:
                    path.unlink()
            try:
                path.parent.rmdir()
            except OSError:
                pass
    try:
        (legacy.parent / "objects").rmdir()
    except OSError:
        pass
    legacy.unlink(missing_ok=True)


def legacy_device(path: Path) -> dict:
    if not path.is_file():
        raise SyncError(f"No legacy archive at {path}")
    with sqlite3.connect(path.as_uri() + "?mode=ro", uri=True) as db:
        rows = db.execute(
            "SELECT device_id,serial,android_id,user_id,model FROM devices"
        ).fetchall()
    if len(rows) != 1:
        raise SyncError("Legacy archive must contain exactly one phone")
    return dict(zip(("device_id", "serial", "android_id", "user_id", "model"), rows[0]))


def write_archive_readme(root: Path) -> None:
    text = """# Phone archive (JSONL format 2)

Open the source--HASH.jsonl files in a text editor, or grep them. Open images/
and files/ in a file explorer; extensions match their contents where recognized.
manifest.json is the atomic source of truth. Its sources map lists the currently
published files. Source hashes in filenames allow staging a full run without
changing the published snapshot. Old source files are retired after publication.

Each line has data, _sync provenance, distinct superseded history, and a changes
timeline. BLOBs reference ordinary files using archive-relative $file paths.
Images and files with identical bytes are stored once, by SHA256. $encoding:
base64 means the original provider field was a binary BLOB, not a text path.

Run phonesync daily/weekly. Defaults: structured records and shared-file inventory.
Shared-file contents and standalone MMS/full-resolution contact photos are opt-in:
phonesync --files all --attachments

phonesync status        # counts, paths, last report; no phone required
phonesync verify        # hashes, keys, revision chains, and referenced files
phonesync export --source sms
phonesync --describe

CLI readers hold a shared publication lock while pinning a manifest. Editors
already reading a file keep that file on POSIX; refresh the directory after a sync
to discover renamed source files. Directly traversing files during a commit is not
a transactional multi-file read. Copy the archive while phonesync is stopped.

Missing phone records are retained and marked. This is a private plaintext archive,
not a complete phone image. RCS, private app databases, and non-owner profiles are
excluded. Files are owner-only by default. runs/ contains sync reports.
"""
    path = root / "README.md"
    if not path.exists():
        durable_write(path, text.encode())


def execute_sync(
    args: argparse.Namespace, providers: dict, sources: list[str]
) -> tuple[dict, int]:
    adb = ADB(args.serial, args.timeout)
    identity = adb.identity()
    root = args.data_dir or default_root(identity["device_id"])
    if args.dry_run:
        return {
            "dry_run": True,
            "directory": str(root),
            "device": identity,
            "sources": sources,
            "files": args.files,
            "attachments": args.attachments,
            "legacy_migration": str(args.legacy_db)
            if args.legacy_db.is_file() and not (root / "manifest.json").exists()
            else None,
            "note": "No archive writes or phone helper deployment",
        }, 0
    if args.command == "probe":
        result = {"device": identity, "sources": {}}
        with adb.deployed():
            for name in sources:
                log(f"Probing {name}")
                try:
                    count = sum(1 for _ in adb.provider_rows(providers[name][0]))
                    result["sources"][name] = {"status": "ok", "rows": count}
                except (SyncError, subprocess.TimeoutExpired) as exc:
                    result["sources"][name] = {"status": "blocked", "error": str(exc)}
        return result, 2 if any(
            v["status"] != "ok" for v in result["sources"].values()
        ) else 0
    with archive_lock(root):
        migration = None
        current = Archive(root)
        marker = current.manifest.get("migration", {})
        if args.legacy_db.is_file() and (
            not (root / "manifest.json").exists()
            or marker.get("legacy_path") == str(args.legacy_db)
        ):
            old_identity = legacy_device(args.legacy_db)
            if old_identity["device_id"] == identity["device_id"]:
                log("Migrating and verifying the legacy SQLite archive before syncing")
                with archive_lock(args.legacy_db.parent, name=".lock"):
                    migration = migrate_sqlite(root, args.legacy_db, identity)
            elif not current.manifest["sources"]:
                log(
                    "Legacy archive belongs to another phone; preserve it and use phonesync migrate separately"
                )
        archive = Archive(root)
        previous_device = archive.manifest.get("device")
        if previous_device and previous_device["device_id"] != identity["device_id"]:
            raise SyncError(
                "Archive belongs to a different phone; choose a different --data-dir"
            )
        archive.manifest["device"] = identity
        run = now() + "-" + uuid.uuid4().hex[:8]
        report = {
            "run_id": run,
            "started": now(),
            "directory": str(root),
            "device": identity,
            "sources": {},
            "errors": [],
        }
        if migration:
            report["migration"] = migration
        with adb.deployed():
            for name in sources:
                log(f"Syncing {name}")
                try:
                    uri, key = providers[name]
                    report["sources"][name] = archive.update_source(
                        name, key, adb.provider_rows(uri), run
                    ) | {"status": "ok"}
                except (SyncError, subprocess.TimeoutExpired) as exc:
                    report["sources"][name] = {"status": "blocked", "error": str(exc)}
                    report["errors"].append({"source": name, "error": str(exc)})
            for name in ("packages", "properties"):
                log(f"Syncing {name}")
                try:
                    if name == "properties":
                        # Values can contain newlines; serialize native values, never
                        # parse the human-readable getprop value listing.
                        rows = adb.rows("properties")
                    else:
                        rows = []
                        for line in adb.shell(
                            "pm",
                            "list",
                            "packages",
                            "-f",
                            "-i",
                            "-U",
                            "--show-versioncode",
                        ).splitlines():
                            if "=" not in line:
                                raise SyncError("Unexpected package inventory format")
                            rows.append(
                                {"key": line.split("=", 1)[1].split()[0], "raw": line}
                            )
                    report["sources"][name] = archive.update_source(
                        name, "key", rows, run
                    ) | {"status": "ok"}
                except (SyncError, subprocess.TimeoutExpired) as exc:
                    report["sources"][name] = {"status": "blocked", "error": str(exc)}
                    report["errors"].append({"source": name, "error": str(exc)})
            if args.attachments:
                log("Syncing MMS attachments and full-resolution contact photos")
                report["attachments"] = sync_attachments(
                    adb, archive, root, identity["device_id"], run, sources, args.verify
                )
                report["errors"].extend(report["attachments"]["errors"])
            if args.files != "none":
                log("Inventorying shared storage")
                try:
                    rows = list(adb.rows("files", "/sdcard"))
                    summary = adb.last_summary
                    skipped = summary.get("skipped", [])
                    for row in rows:
                        row["mtime"] = row.pop("mtime_ms")
                    report["sources"]["shared_files"] = archive.update_source(
                        "shared_files", "path", rows, run, reconcile=not skipped
                    ) | {"status": "ok"}
                    report["files"] = sync_files(
                        adb,
                        archive,
                        root,
                        identity["device_id"],
                        run,
                        rows,
                        args.files,
                        args.verify,
                        args.refresh_files,
                    )
                    report["files"].update(
                        skipped=skipped, skipped_count=summary.get("skipped_count", 0)
                    )
                    report["errors"].extend(report["files"]["errors"])
                    if skipped:
                        report["errors"].append(
                            {
                                "source": "shared_files",
                                "error": "Some directories inaccessible; see files.skipped",
                            }
                        )
                except (SyncError, subprocess.TimeoutExpired) as exc:
                    report["errors"].append(
                        {"source": "shared_files", "error": str(exc)}
                    )
        report["status"] = "partial" if report["errors"] else "ok"
        report["finished"] = now()
        log("Publishing the completed run atomically")
        archive.commit(report)
        write_archive_readme(root)
        return report, 2 if report["errors"] else 0


def verify_archive(archive: Archive) -> dict:
    """Check every source, distinct state, timeline reference, and binary asset."""

    def original(value):
        if (
            isinstance(value, dict)
            and value.get("$encoding") == "base64"
            and "$file" in value
        ):
            return archive.restore(value)
        if isinstance(value, dict):
            return {key: original(child) for key, child in value.items()}
        if isinstance(value, list):
            return [original(child) for child in value]
        return value

    result = {
        "status": "ok",
        "sources": {},
        "records": 0,
        "superseded_states": 0,
        "assets": 0,
    }
    for source in archive.manifest["sources"]:
        entries = archive.read_source(source)
        for entry in entries.values():
            current = entry["_sync"]["sha256"]
            states = [{"sha256": current, "data": entry["data"]}, *entry["history"]]
            hashes = set()
            for state in states:
                if state["sha256"] in hashes:
                    raise SyncError(
                        f"Duplicate payload state in {source}/{entry['_sync']['id']}"
                    )
                hashes.add(state["sha256"])
                if (
                    hashlib.sha256(
                        canonical(original(state["data"])).encode()
                    ).hexdigest()
                    != state["sha256"]
                ):
                    raise SyncError(
                        f"Record SHA256 mismatch in {source}/{entry['_sync']['id']}"
                    )
            if any(change["sha256"] not in hashes for change in entry["changes"]):
                raise SyncError(
                    f"History timeline references unknown payload in {source}"
                )
            result["superseded_states"] += len(entry["history"])
        result["sources"][source] = len(entries)
        result["records"] += len(entries)
    for ref in archive.manifest["assets"].values():
        archive.assets.read(ref)
        result["assets"] += 1
    for ref in archive.manifest["runs"]:
        data = archive_path(archive.root, ref["path"]).read_bytes()
        if hashlib.sha256(data).hexdigest() != ref["sha256"]:
            raise SyncError(f"Run report SHA256 mismatch: {ref['path']}")
        json.loads(data)
    return result


def discover_root(explicit: Path | None, device_id: str | None) -> Path:
    if explicit:
        return explicit.expanduser().resolve()
    if device_id:
        return default_root(device_id)
    candidates = sorted(
        path.parent
        for path in (Path.home() / "Documents/data").glob("phone-*/manifest.json")
    )
    if len(candidates) != 1:
        raise SyncError(
            "Choose --data-dir or --device; exactly one phone archive is required for automatic discovery"
        )
    return candidates[0]


