# When adding a new custom keybinding, add its path to the [/] list below. Then see ../linux.md for how to load this dconf file.

[/]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/downloads/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/suspend/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ask-win/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/flameshot/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/picker/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/prompts/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/rofi-clip/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/copy-to-markdown/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/chatgpt/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/clean-markdown/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/restore-dock/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/music-toggle/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/music-previous/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/music-next/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/music-backward/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/music-forward/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/music-open/']

# Default media keybindings
# gsettings list-keys org.gnome.settings-daemon.plugins.media-keys  # List all media keys
logout=@as []

# Set Win+L to lock screen. Same as Windows
screensaver=['<Super>l']

# Win+E opens Downloads, not the home folder
home=@as []
[custom-keybindings/downloads]
binding='<Super>e'
command='xdg-open /home/sanand/Downloads'
name='Open Downloads'

# Ctrl+Alt+BackSpace to suspend
[custom-keybindings/suspend]
binding='<Control><Alt>BackSpace'
command='systemctl suspend'
name='Suspend'

# Ctrl+Alt+0 opens voice input terminal
[custom-keybindings/ask-win]
binding='<Control><Alt>0'
command="bash -lc 'ACTIVE=$(xdotool getactivewindow); gnome-terminal --zoom=1.2 --geometry=120x10 --wait -- bash -lc \"ACTIVE_WIN=$ACTIVE /home/sanand/code/scripts/askwin\"'"
name='Ask Win'

# Replace Print key to open Flameshot GUI
[custom-keybindings/flameshot]
binding='Print'
command='flameshot gui'
name='Flameshot'

# Ctrl+Alt+F opens rofi file picker
[custom-keybindings/picker]
binding='<Control><Alt>f'
command='rofi -show-icons -show combi -modes combi -combi-modes "window,🌍:/home/sanand/code/scripts/rofi-chrome-tabs.sh,📝:/home/sanand/code/scripts/rofi-files.sh" -kb-accept-alt "" -kb-accept-custom "" -kb-accept-custom-alt "" -kb-custom-1 "Shift+Return" -kb-custom-2 "Control+Return" -kb-custom-3 "Control+Shift+Return"'
name='Picker'

# Ctrl+Alt+P opens rofi prompts picker
[custom-keybindings/prompts]
binding='<Control><Alt>p'
command='/home/sanand/code/scripts/prompt'
name='Prompts'

# Ctrl+Alt+M opens rofi clipboard transformer
[custom-keybindings/rofi-clip]
binding='<Control><Alt>m'
command='/home/sanand/code/scripts/rofi-clip.sh'
name='Rofi Clip'

# Ctrl+Alt+C to convert clipboard rich text to markdown
[custom-keybindings/copy-to-markdown]
binding='<Control><Alt>c'
command='/home/sanand/code/scripts/copy-to-markdown.sh'
name='Copy to Markdown'

# Ctrl+Win+C opens ChatGPT after the active tab in the Edge window containing Gmail
[custom-keybindings/chatgpt]
binding='<Control><Super>c'
command='/home/sanand/code/scripts/edge open --window mail.google https://chatgpt.com/'
name='Open ChatGPT'

# Ctrl+Alt+L to clean markdown text in clipboard
[custom-keybindings/clean-markdown]
binding='<Control><Alt>l'
command='/home/sanand/code/scripts/clean_markdown.py --xclip'
name='Clean Markdown'

# Ctrl+Alt+U to restore the dock after unlocking
[custom-keybindings/restore-dock]
binding='<Control><Alt>u'
command='/home/sanand/code/scripts/dock.sh'
name='Restore Dock'

# Ctrl+Win+Up increases volume
volume-step-up=['<Control><Super>Up']
# Ctrl+Win+Down decreases volume
volume-step-down=['<Control><Super>Down']

# Music controls below use CDP to target Music without changing focus.
# Clear the old native bindings so GNOME does not dispatch them twice.
play=@as []
volume-up=['<Control><Super>Up']
volume-down=['<Control><Super>Down']
previous=@as []
next=@as []

[custom-keybindings/music-toggle]
binding='<Control><Super>space'
command="/home/sanand/code/scripts/edge js 'Music · Your files, your listening' 'music.control({\"action\":\"toggle\"}).then(state=>{if(state.error)throw new Error(state.error);return state})'"
name='Music play/pause'

[custom-keybindings/music-previous]
binding='<Control><Super>Page_Up'
command="/home/sanand/code/scripts/edge js 'Music · Your files, your listening' 'music.control({\"action\":\"previous\"}).then(state=>{if(state.error)throw new Error(state.error);return state})'"
name='Music previous track'

[custom-keybindings/music-next]
binding='<Control><Super>Page_Down'
command="/home/sanand/code/scripts/edge js 'Music · Your files, your listening' 'music.control({\"action\":\"next\"}).then(state=>{if(state.error)throw new Error(state.error);return state})'"
name='Music next track'

[custom-keybindings/music-backward]
binding='<Control><Super>Left'
command="/home/sanand/code/scripts/edge js 'Music · Your files, your listening' 'music.control({\"action\":\"backward\",\"seconds\":5}).then(state=>{if(state.error)throw new Error(state.error);return state})'"
name='Music seek backward 5 seconds'

[custom-keybindings/music-forward]
binding='<Control><Super>Right'
command="/home/sanand/code/scripts/edge js 'Music · Your files, your listening' 'music.control({\"action\":\"forward\",\"seconds\":5}).then(state=>{if(state.error)throw new Error(state.error);return state})'"
name='Music seek forward 5 seconds'

# Ctrl+Win+M focuses the installed Music PWA, or launches it if closed
[custom-keybindings/music-open]
binding='<Control><Super>m'
command="bash -lc 'f=$(grep -l \"^Name=Music$\" \"$HOME\"/.local/share/applications/*.desktop 2>/dev/null | head -1); if [ -n \"$f\" ]; then gio launch \"$f\"; else xdg-open https://tools.s-anand.net/music/; fi'"
name='Open Music'
