def format_languages() -> str:
    """Show all supported codes and full language names in two readable columns."""
    lines = [f"{', '.join(codes):<12} {name}" for name, codes in LANGUAGES.items()]
    half = (len(lines) + 1) // 2
    width = max(len(line) for line in lines[:half]) + 3
    return ("Supported languages (code — full name):\n" +
            "\n".join(f"  {left:<{width}}{right}"
                      for left, right in zip(lines[:half], lines[half:] + [""] * half)))
