#!/bin/bash
# Usage:
#   rgb FFFFFF      -> outputs: 255 255 255
#   rgb 255 255 255  -> outputs: FFFFFF

if [ "$#" -eq 1 ]; then
    # Remove leading '#' if present
    hex="${1/#\#/}"
    # Check if the length is exactly 6 characters
    if ! [[ $hex =~ ^[[:xdigit:]]{6}$ ]]; then
        echo "Error: Hex color must be exactly 6 hex digits." >&2
        exit 1
    fi
    # Extract the two-character components and convert to decimal
    r=$((16#${hex:0:2}))
    g=$((16#${hex:2:2}))
    b=$((16#${hex:4:2}))
    printf "%d %d %d\n" "$r" "$g" "$b"

elif [ "$#" -eq 3 ]; then
    # Validate that each argument is a number between 0 and 255
    decimal=()
    for value in "$@"; do
        if ! [[ $value =~ ^[0-9]+$ ]]; then
            echo "Error: Each value must be a number between 0 and 255." >&2
            exit 1
        fi
        value="${value#"${value%%[!0]*}"}"
        value="${value:-0}"
        if [[ ${#value} -gt 3 ]] || (( 10#$value > 255 )); then
            echo "Error: Each value must be a number between 0 and 255." >&2
            exit 1
        fi
        decimal+=("$((10#$value))")
    done
    # Convert each decimal to a two-digit uppercase hex string
    printf "%02X%02X%02X\n" "${decimal[@]}"

else
    echo "Usage:"
    echo "  $0 HEXCOLOR       (e.g., FFFFFF or #FFFFFF)  -> outputs: 255 255 255"
    echo "  $0 R G B          (e.g., 255 255 255)          -> outputs: FFFFFF"
    exit 1
fi
