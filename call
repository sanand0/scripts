@dataclass(frozen=True)
class ResolvedPrompts:
    system_prompt: str
    user_prompt: str | None
    note_prompt: str


def resolve_prompts(system_prompt: str, stored_prompt: str | None, cli_prompt: str | None) -> ResolvedPrompts:
    """Resolve the prompt to send to Gemini and the prompt to persist in frontmatter.

    Both prefer the CLI `--prompt`, then the note's stored prompt, then the system prompt.
    The stored/system prompt is only sent to Gemini as user context when it differs from
    the system prompt; sending it verbatim as both would be redundant.
    """
    cleaned_system_prompt = system_prompt.strip()
    cleaned_stored_prompt = stored_prompt.strip() if stored_prompt else None
    if cli_prompt is not None:
        user_prompt = cli_prompt
    elif cleaned_stored_prompt and cleaned_stored_prompt != cleaned_system_prompt:
        user_prompt = cleaned_stored_prompt
    else:
        user_prompt = None
    note_prompt = cli_prompt or cleaned_stored_prompt or cleaned_system_prompt
    return ResolvedPrompts(system_prompt=system_prompt, user_prompt=user_prompt, note_prompt=note_prompt)


def render_prompt_metadata(prompt: str) -> str:
    """Render prompt metadata as a YAML block scalar."""
    lines = prompt.strip().splitlines() or [""]
    return "prompt: |-\n" + "".join(f"  {line}\n" for line in lines)


def extract_prompt_metadata(markdown: str) -> str | None:
    """Return the stored prompt metadata from the note frontmatter, if present."""
    import yaml

    match = FRONTMATTER_RE.match(markdown)
    if not match:
        return None
    frontmatter = yaml.safe_load(match.group("body")) or {}
    if not isinstance(frontmatter, dict) or "prompt" not in frontmatter:
        return None
    prompt = frontmatter["prompt"]
    if prompt is None:
        return None
    if isinstance(prompt, str):
        return prompt.rstrip()
    return str(prompt).rstrip()


def set_frontmatter_fields(markdown: str, fields: dict[str, str], *, prepend: bool) -> str:
    """Add or update the given YAML frontmatter keys, preserving unrelated ones.

    `prepend` controls whether the new keys go before or after what's kept, so callers can
    build up frontmatter (e.g. model/cost first, prompt last) across multiple calls.
    """
    new_lines = [
        render_prompt_metadata(value).rstrip() if key == "prompt" else f"{key}: {value}"
        for key, value in fields.items()
    ]
    match = FRONTMATTER_RE.match(markdown)
    if not match:
        body = "\n".join(new_lines)
        return f"---\n{body}\n---\n\n{markdown.lstrip()}"
    kept_lines: list[str] = []
    skipping = False
    for line in match.group("body").splitlines():
        if skipping:
            if line.startswith((" ", "\t")):
                continue
            skipping = False
        if line.split(":", 1)[0] in fields:
            skipping = True
            continue
        kept_lines.append(line)
    ordered_lines = new_lines + kept_lines if prepend else kept_lines + new_lines
    body = "\n".join(ordered_lines).strip()
    remainder = markdown[match.end() :].lstrip("\n")
    return f"---\n{body}\n---\n\n{remainder}" if remainder else f"---\n{body}\n---\n"


def set_prompt_metadata(markdown: str, prompt: str) -> str:
    """Add or update the prompt key in note frontmatter, keeping it last."""
    return set_frontmatter_fields(markdown, {"prompt": prompt}, prepend=False)


def set_model_cost_metadata(markdown: str, model: str, cost_usd: float | None) -> str:
    """Add or update the transcription model and dollar cost in note frontmatter, keeping them first."""
    return set_frontmatter_fields(markdown, {"model": model, "cost": "unknown" if cost_usd is None else f"{cost_usd:.6f}"}, prepend=True)


def extract_system_prompt(markdown: str) -> str:
    """Return the first fenced code block content, else the full Markdown body."""
    match = CODE_FENCE_RE.search(markdown)
    prompt = (match.group(1) if match else markdown).strip()
    if not prompt:
        raise ValueError("System prompt is empty.")
    return prompt


def load_system_prompt(prompt_file: Path) -> str:
    """Return the configured system prompt, falling back for the historical default path."""
    if prompt_file.is_file():
        return extract_system_prompt(prompt_file.read_text(encoding="utf-8"))
    if prompt_file == DEFAULT_PROMPT_FILE:
        typer.echo(
            f"WARNING default prompt file missing: {prompt_file}; using built-in system prompt {DEFAULT_SYSTEM_PROMPT!r}.",
            err=True,
        )
        return DEFAULT_SYSTEM_PROMPT
    raise typer.BadParameter(f"Prompt file does not exist: {prompt_file}")


def has_transcript_content(markdown: str) -> bool:
    """Return True when the document already has a non-empty transcript section."""
    match = TRANSCRIPT_SECTION_RE.search(markdown)
    return bool(match and match.group("body").strip())


def count_transcript_sections(markdown: str) -> int:
    """Return the number of transcript sections in a Markdown document."""
    return len(list(TRANSCRIPT_SECTION_RE.finditer(markdown)))


def render_new_document(title: str, transcript: str, prompt: str) -> str:
    """Render a new transcript Markdown file using the current note template."""
    cleaned = transcript.strip()
    if not cleaned:
        raise ValueError("Transcript output is empty.")
    return (
        "---\n"
        f"{render_prompt_metadata(prompt)}"
        "---\n\n"
        f"# {title}\n\n"
        "## Transcript\n\n"
        f"{cleaned}\n"
    )


def upsert_transcript_section(markdown: str, title: str, transcript: str, prompt: str | None = None) -> str:
    """Insert or replace the transcript section while preserving other sections."""
    cleaned = transcript.strip()
    if not cleaned:
        raise ValueError("Transcript output is empty.")
    if not markdown.strip():
        if prompt is None:
            raise ValueError("Prompt metadata is required for new transcript notes.")
        return render_new_document(title, cleaned, prompt=prompt)
    working_markdown = set_prompt_metadata(markdown, prompt) if prompt is not None else markdown
    if count_transcript_sections(markdown) > 1:
        raise ValueError("Document has multiple ## Transcript sections.")

    match = TRANSCRIPT_SECTION_RE.search(working_markdown)
    if not match:
        return f"{working_markdown.rstrip()}\n\n## Transcript\n\n{cleaned}\n"

    prefix = working_markdown[: match.start()].rstrip()
    suffix = working_markdown[match.end() :].lstrip("\n")
    rebuilt = "\n\n".join(part for part in (prefix, "## Transcript", cleaned) if part)
    if suffix:
        rebuilt = f"{rebuilt}\n\n{suffix.rstrip()}"
    return f"{rebuilt}\n"


def split_transcript_parts(transcript: str) -> list[str]:
    """Return transcript parts separated by the chunk delimiter."""
    cleaned = transcript.strip()
    if not cleaned:
        return []
    return [part.strip() for part in transcript.split(TRANSCRIPT_PART_SEPARATOR)]


def patch_transcript_section(markdown: str, section_index: int, transcript: str, prompt: str | None = None) -> str:
    """Replace one transcript chunk inside an existing transcript section."""
    match = TRANSCRIPT_SECTION_RE.search(markdown)
    if not match or not match.group("body").strip():
        raise ValueError("Document has no transcript section to patch.")
    parts = split_transcript_parts(match.group("body"))
    if section_index < 1 or section_index > len(parts):
        raise ValueError(f"Document transcript has {len(parts)} section(s); cannot patch section {section_index}.")
    parts[section_index - 1] = transcript.strip()
    return upsert_transcript_section(markdown, "", TRANSCRIPT_PART_SEPARATOR.join(parts), prompt=prompt)


def find_invalid_transcript_sections(markdown: str) -> list[int]:
    """Return 1-based transcript section indices that do not look like transcript text."""
    match = TRANSCRIPT_SECTION_RE.search(markdown)
    if not match or not match.group("body").strip():
        return []
    return [
        index
        for index, part in enumerate(split_transcript_parts(match.group("body")), start=1)
        if not looks_like_transcript(part)
    ]


def count_matching_transcript_lines(transcript: str) -> int:
    """Count lines that look like transcript speaker lines."""
    return sum(1 for line in transcript.splitlines() if TRANSCRIPT_LINE_RE.match(line.strip()))


def looks_like_transcript(transcript: str, min_matching_lines: int = 1) -> bool:
    """Accept short conversations; length alone does not indicate a bad transcript."""
    return count_matching_transcript_lines(transcript) >= min_matching_lines or is_silence(transcript)


def is_silence(transcript: str) -> bool:
    """Recognize explicit silent/inaudible chunk markers without demanding speaker turns."""
    return bool(re.fullmatch(r"\[?(?:silence|no speech|inaudible)\]?", transcript.strip(), re.IGNORECASE))


def timestamp_tools() -> Any:
    """Reuse the sibling timestamp CLI's pure parsing and shifting helpers."""
    try:
        import timestamp
    except ImportError as exc:
        raise RuntimeError("Missing timestamp.py helper. Install timestamp.py next to call before transcribing.") from exc
    return timestamp


def render_chunk_timestamps(transcript: str, start_seconds: float) -> str:
    """Shift known-local timestamps by the exact overlapping audio-window start."""
    return timestamp_tools().shift_chunk(transcript, round(start_seconds))[0]


def normalize_chunk(transcript: str, window: tuple[float, float]) -> tuple[str, str | None]:
    """Repair formatting and clear offsets; preserve text when timestamps are ambiguous."""
    cleaned = transcript.strip()
    fence = CODE_FENCE_RE.fullmatch(cleaned)
    if fence:
        cleaned = fence[1].strip()
    # Reserve the note's separator for actual audio chunks; keep model decorations equivalent.
    cleaned = cleaned.replace("\n\n---\n\n", "\n\n***\n\n")
    if is_silence(cleaned):
        return cleaned, None
    tools = timestamp_tools()
    try:
        values = tools.timestamp_values(cleaned)
    except ValueError as exc:
        return cleaned, f"Invalid timestamp: {exc}; review the cached raw response or use --patch."
    start, duration = window
    if not values:
        if looks_like_transcript(cleaned):
            return cleaned, "No timestamps; text preserved. Add timestamps manually or use --patch."
        return cleaned, None
    if any(current < previous for previous, current in zip(values, values[1:])):
        return cleaned, "Non-monotonic timestamps; text preserved. Review manually or use --patch."
    # Normalize global output only when its first timestamp clearly identifies the boundary.
    if start > 0 and values[0] >= round(start) and abs(values[0] - start) <= CHUNK_OVERLAP_SECONDS:
        if values[-1] <= duration + CHUNK_OVERLAP_SECONDS:
            return cleaned, "Ambiguous timestamp origin: both local and cumulative times fit; text preserved. Review manually or use --patch."
        cleaned = tools.shift_chunk(cleaned, -round(start))[0]
        values = [value - round(start) for value in values]
    if values[0] > duration + CHUNK_OVERLAP_SECONDS:
        return cleaned, "Ambiguous timestamp origin: first timestamp exceeds chunk duration; text preserved. Review manually or use --patch."
    if values[-1] > duration + CHUNK_OVERLAP_SECONDS:
        # Keep the established continuation cutoff, but raw output is persisted first.
        lines = cleaned.splitlines()
        for index, line in enumerate(lines):
            line_values = tools.timestamp_values(line)
            if line_values and max(line_values) > duration + CHUNK_OVERLAP_SECONDS:
                boundary = next(bracket for bracket in tools.TIMESTAMP_BRACKET_RE.finditer(line)
                    if max(tools.timestamp_values(bracket.group())) > duration + CHUNK_OVERLAP_SECONDS)
                prefix = line[:boundary.start()].rstrip()
                kept = lines[:index] + ([prefix] if looks_like_transcript(prefix) else [])
                trimmed = "\n".join(kept).strip()
                append_run(None, "continuation_trimmed", window=window, original_chars=len(cleaned), kept_chars=len(trimmed))
                cleaned = trimmed
                break
    return cleaned, None


def atomic_write(path: Path, text: str) -> None:
    """Replace a document atomically, preserving permissions and the original on failure."""
    path = path.resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", delete=False) as handle:
        temp_path = Path(handle.name)
        try:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
            if path.exists():
                temp_path.chmod(path.stat().st_mode & 0o777)
            os.replace(temp_path, path)
        finally:
            temp_path.unlink(missing_ok=True)


def preflight_write(path: Path) -> None:
    """Test actual destination access before any paid request, without changing its contents."""
    path = path.resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        with path.open("r+b"):
            pass
    with tempfile.TemporaryFile(dir=path.parent):
        pass


def sum_costs(costs: list[float | None]) -> float | None:
    """Unknown billing must not silently become a zero-cost attempt."""
    return None if any(cost is None for cost in costs) else sum(costs)


def generation_settings(model: str) -> dict[str, Any]:
    """Explicit thinking levels are part of the exact request and cache identity."""
    level = os.environ.get("TRANSCRIBE_CALLS_THINKING", "default").lower()
    if level not in {"default", "minimal", "low", "medium", "high"}:
        raise RuntimeError("TRANSCRIBE_CALLS_THINKING must be default, minimal, low, medium or high.")
    return {} if level == "default" else {"thinking_config": {"thinking_level": level}}


def context_limits() -> tuple[int, int]:
    """Allow bounded continuity experiments without changing the command's modes."""
    try:
        lines = int(os.environ.get("TRANSCRIBE_CALLS_CONTEXT_LINES", CHUNK_CONTEXT_MAX_LINES))
        chars = int(os.environ.get("TRANSCRIBE_CALLS_CONTEXT_CHARS", CHUNK_CONTEXT_MAX_CHARS))
        if lines < 0 or chars < 0:
            raise ValueError("negative limit")
        return lines, chars
    except ValueError as exc:
        raise RuntimeError("TRANSCRIBE_CALLS_CONTEXT_LINES and TRANSCRIBE_CALLS_CONTEXT_CHARS must be non-negative integers; 0 disables context.") from exc


def append_run(cache_dir: Path | None, event: str, **fields: Any) -> None:
    """Append one parseable event; raw transcript/prompt content stays in the chunk record."""
    record = {"time": time.time(), "pid": os.getpid(), "run_id": RUN_DIR.name if RUN_DIR else None, "event": event, **fields}
    paths = ([cache_dir / "run.jsonl"] if cache_dir else []) + ([RUN_DIR / "events.jsonl"] if RUN_DIR else [])
    for path in paths:
        with path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, ensure_ascii=False, default=str) + "\n")


class LogStream:
    """Mirror console output immediately while preserving normal terminal behavior."""

    def __init__(self, stream: Any, log: Any):
        self.stream, self.log = stream, log

    def write(self, text: str) -> int:
        self.log.write(text)
        self.log.flush()
        return self.stream.write(text)

    def flush(self) -> None:
        self.log.flush()
        self.stream.flush()

    def __getattr__(self, name: str) -> Any:
        return getattr(self.stream, name)


def run_cli() -> None:
    """Capture every operational invocation, including parsing errors and interrupts."""
    global RUN_DIR
    if sys.argv[1:] == ["--help"]:
        app()
        return
    cache_dir = Path(os.environ.get("TRANSCRIBE_CALLS_CACHE_DIR", DEFAULT_CACHE_DIR))
    RUN_DIR = cache_dir / "runs" / f"{datetime.now(UTC):%Y%m%dT%H%M%S.%fZ}-{uuid.uuid4().hex[:8]}"
    try:
        RUN_DIR.mkdir(parents=True, mode=0o700)
    except OSError as exc:
        typer.echo(f"ERROR cannot create diagnostic logs at {RUN_DIR}: {exc}. Set TRANSCRIBE_CALLS_CACHE_DIR to a writable directory; no API request made.", err=True)
        raise SystemExit(1) from exc
    started = time.monotonic()
    packages = {}
    for name in ("google-genai", "typer"):
        try:
            packages[name] = version(name)
        except PackageNotFoundError:
            packages[name] = "unknown"
    summary = {"run_id": RUN_DIR.name, "started_at": datetime.now(UTC).isoformat(),
        "argv": sys.argv[1:], "cwd": os.getcwd(), "python": sys.version, "packages": packages,
        "code_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "executables": {name: shutil.which(name) for name in ("ffmpeg", "ffprobe")},
        "configuration": {key: os.environ[key] for key in ("TRANSCRIBE_CALLS_MODEL", "TRANSCRIBE_CALLS_CACHE_DIR",
            "TRANSCRIBE_CALLS_PRICES_CACHE", "TRANSCRIBE_CALLS_PRICES_URL", "TRANSCRIBE_CALLS_THINKING",
            "TRANSCRIBE_CALLS_CONTEXT_LINES", "TRANSCRIBE_CALLS_CONTEXT_CHARS") if key in os.environ},
        "status": "running"}
    atomic_write(RUN_DIR / "summary.json", json.dumps(summary, indent=2))
    exit_code = 0
    with (RUN_DIR / "console.log").open("w", encoding="utf-8") as log, redirect_stdout(LogStream(sys.stdout, log)), redirect_stderr(LogStream(sys.stderr, log)):
        typer.echo(f"Run logs: {RUN_DIR}", err=True)
        append_run(None, "run_start", **summary)
        try:
            app()
        except SystemExit as exc:
            exit_code = exc.code if isinstance(exc.code, int) else 1
            raise
        except BaseException as exc:
            exit_code = 130 if isinstance(exc, KeyboardInterrupt) else 1
            traceback.print_exc()
            raise
        finally:
            events = [json.loads(line) for line in (RUN_DIR / "events.jsonl").read_text().splitlines()]
            attempts = [row for row in events if row["event"] in {"attempt", "attempt_error"}]
            costs = [row["usage"]["cost_usd"] if row.get("usage") else None for row in attempts]
            summary.update(status="complete" if exit_code == 0 else "failed", exit_code=exit_code,
                elapsed_seconds=time.monotonic() - started, finished_at=datetime.now(UTC).isoformat(),
                api_attempts=sum(row["event"] == "attempt_start" for row in events),
                cache_hits=sum(row["event"] == "cache_hit" for row in events),
                new_cost_usd=sum_costs(costs), saved_notes=[row for row in events if row["event"] == "saved"],
                errors=[row for row in events if row["event"] in {"error", "attempt_error"}])
            append_run(None, "run_end", exit_code=exit_code, elapsed_seconds=summary["elapsed_seconds"])
            atomic_write(RUN_DIR / "summary.json", json.dumps(summary, indent=2))


def resolve_audio_path(audio_arg: str, input_dir: Path) -> Path:
    """Resolve an audio argument to a file path.

    A path that exists (absolute, or relative to the cwd) is used directly. Otherwise the
    argument is matched case-insensitively against audio filenames in `input_dir`: an exact
    stem match wins outright, else it's matched as a substring of the stem. Since filenames
    start with `YYYY-MM-DD`, ties are broken by taking the most recent (highest-sorting) name.
    """
    given = Path(audio_arg)
    if given.exists():
        return given
    if given.is_absolute() or len(given.parts) > 1:
        raise typer.BadParameter(f"Audio file does not exist: {given}")
    query = (given.stem if given.suffix.lower() in AUDIO_SUFFIXES else str(given)).lower()
    audio_files = [
        path for path in input_dir.glob("*") if path.is_file() and path.suffix.lower() in AUDIO_SUFFIXES
    ]
    exact = [path for path in audio_files if path.stem.lower() == query]
    matches = exact or [path for path in audio_files if query in path.stem.lower()]
    if not matches:
        raise typer.BadParameter(f"No audio file matching {audio_arg!r} found in {input_dir}")
    return max(matches, key=lambda path: path.name)


def read_existing_note(note_path: Path) -> tuple[bool, str, int]:
    """Return whether a note exists, its content, and its transcript-section count."""
    if not note_path.exists():
        return False, "", 0
    try:
        markdown = note_path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise RuntimeError(f"{note_path.name}: failed to read existing Markdown: {exc}") from exc
    transcript_sections = count_transcript_sections(markdown)
    if transcript_sections > 1:
        raise RuntimeError(f"{note_path.name}: document has multiple ## Transcript sections; merge them into one section before rerunning.")
    return True, markdown, transcript_sections


def list_audio_files(input_dir: Path) -> list[Path]:
    """Return all supported audio files directly inside `input_dir`, sorted by name."""
    return sorted(
        path for path in input_dir.glob("*") if path.is_file() and path.suffix.lower() in AUDIO_SUFFIXES
    )


def find_notes_with_transcript_content(output_dir: Path) -> set[Path]:
    """Find complete notes without reading every transcript; incomplete notes remain pending."""
    if not output_dir.exists():
        return set()
    matches: list[set[Path]] = []
    for pattern in (TRANSCRIPT_CONTENT_RG_PATTERN, r"^transcription_status: incomplete$"):
        result = subprocess.run(
            ["rg", "-l", "-U", "-P", pattern, "--glob", "*.md", "--", str(output_dir)],
            capture_output=True, text=True, check=False,
        )
        if result.returncode not in (0, 1):
            raise RuntimeError(f"Failed to scan transcript notes: {result.stderr.strip() or result.returncode}")
        matches.append({Path(line) for line in result.stdout.splitlines()})
    incomplete = {path for path in matches[1] if note_metadata(path.read_text(encoding="utf-8")).get("transcription_status") == "incomplete"}
    return matches[0] - incomplete


def emit_change_list(audio_files: list[Path], output_dir: Path) -> None:
    """Emit create/update actions as TSV for audio files without a transcript, without probing audio."""
    completed_notes = find_notes_with_transcript_content(output_dir)
    changes = 0
    for audio_path in audio_files:
        output_path = output_dir / f"{audio_path.stem}.md"
        if output_path in completed_notes:
            continue
        had_output, markdown, _ = read_existing_note(output_path)
        if has_transcript_content(markdown) and note_metadata(markdown).get("transcription_status") != "incomplete":
            continue
        typer.echo(f"{'update' if had_output else 'create'}\t{audio_path}\t{output_path}")
        changes += 1
    typer.echo(f"changes={changes}", err=True)


def normalize_model_id(model_id: str) -> str:
    """Normalize model identifiers so pricing ids and requested model names match."""
    return re.sub(r"-+", "-", model_id.strip().lower().replace(".", "-"))


def parse_google_pricing(payload: object, source: str) -> dict[str, dict[str, object]]:
    """Parse an llm-prices JSON payload into a normalized model-id -> price-entry map."""
    models = payload.get("models") if isinstance(payload, dict) else None
    if not isinstance(models, list):
        raise RuntimeError(f"Google pricing data from {source} is missing models.")
    pricing: dict[str, dict[str, object]] = {}
    for model_entry in models:
        if not isinstance(model_entry, dict):
            continue
        model_id = model_entry.get("id")
        history = model_entry.get("price_history")
        if not isinstance(model_id, str) or not isinstance(history, list) or not history:
            continue
        latest = history[0]
        if isinstance(latest, dict):
            # llm-prices omits audio modality rates. Audited 2026-10-01:
            # https://ai.google.dev/gemini-api/docs/pricing#gemini-3-flash-preview
            if normalize_model_id(model_id) == normalize_model_id(DEFAULT_MODEL):
                latest = {"input_audio": 1.0, "input_cached_audio": 0.10, **latest}
                if latest.get("input_cached") is None:
                    latest["input_cached"] = 0.05
            pricing[normalize_model_id(model_id)] = latest
    if not pricing:
        raise RuntimeError(f"Google pricing data from {source} did not contain usable models.")
    return pricing


@lru_cache(maxsize=1)
def load_google_pricing() -> dict[str, dict[str, object]]:
    """Load Google pricing data from llm-prices, falling back to the last cached copy on
    a network failure so a flaky connection doesn't block transcription outright."""
    url = os.environ.get("TRANSCRIBE_CALLS_PRICES_URL", PRICES_URL)
    cache_path = Path(os.environ.get("TRANSCRIBE_CALLS_PRICES_CACHE", DEFAULT_PRICES_CACHE_PATH))
    if cache_path.is_file() and time.time() - cache_path.stat().st_mtime < 3600:
        return parse_google_pricing(json.loads(cache_path.read_text(encoding="utf-8")), str(cache_path))
    try:
        preflight_write(cache_path)
        with urlopen(url, timeout=30) as response:
            payload = json.load(response)
        pricing = parse_google_pricing(payload, url)
    except (OSError, URLError, json.JSONDecodeError, RuntimeError) as exc:
        if not cache_path.is_file():
            raise RuntimeError(f"Failed to load Google pricing data from {url}: {exc}") from exc
        typer.echo(
            f"WARNING failed to fetch Google pricing data from {url} ({exc}); using cached copy.",
            err=True,
        )
        return parse_google_pricing(json.loads(cache_path.read_text(encoding="utf-8")), str(cache_path))
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(cache_path, json.dumps(payload))
    return pricing


def select_price_entry(
    pricing: dict[str, dict[str, object]],
    requested_model: str,
    prompt_tokens: int,
    response_model: str | None = None,
) -> dict[str, object]:
    """Select the best pricing record for the requested model and token volume."""
    candidate_models = [requested_model]
    if response_model and response_model != requested_model:
        candidate_models.append(response_model)

    for model_name in candidate_models:
        normalized = normalize_model_id(model_name)
        explicit = pricing.get(normalized)
        if explicit and (normalized.endswith("-200k") or normalized.endswith("-128k")):
            return explicit
        if prompt_tokens > 200_000 and f"{normalized}-200k" in pricing:
            return pricing[f"{normalized}-200k"]
        if prompt_tokens > 128_000 and f"{normalized}-128k" in pricing:
            return pricing[f"{normalized}-128k"]
        if explicit:
            return explicit
    raise RuntimeError(f"No Google pricing entry found for model {requested_model}.")


def calculate_usage_cost(
    response: object,
    requested_model: str,
    pricing: dict[str, dict[str, object]],
) -> UsageCost:
    """Estimate mixed-modality billing from reported usage, including cached audio/thinking."""
    usage = getattr(response, "usage_metadata", None)
    if usage is None:
        return UsageCost(0, 0, 0, None)
    prompt_tokens = int(getattr(usage, "prompt_token_count", 0) or 0)
    cached_tokens = int(getattr(usage, "cached_content_token_count", 0) or 0)
    thought_tokens = int(getattr(usage, "thoughts_token_count", 0) or 0)
    output_tokens = int(getattr(usage, "candidates_token_count", 0) or 0) + thought_tokens
    total_tokens = int(getattr(usage, "total_token_count", 0) or (prompt_tokens + output_tokens))
    def modality_counts(field: str) -> dict[str, int]:
        return {
            str(getattr(item.modality, "value", item.modality)).upper(): int(item.token_count or 0)
            for item in (getattr(usage, field, None) or [])
        }

    prompts = modality_counts("prompt_tokens_details")
    cached = modality_counts("cache_tokens_details")

    def result(cost: float | None) -> UsageCost:
        return UsageCost(prompt_tokens, output_tokens, total_tokens, cost,
            audio_tokens=prompts.get("AUDIO", 0), cached_audio_tokens=cached.get("AUDIO", 0),
            cached_tokens=cached_tokens, thought_tokens=thought_tokens)

    try:
        price = select_price_entry(pricing, requested_model, prompt_tokens, getattr(response, "model_version", None))
    except RuntimeError:
        return result(None)
    # Audio is attached on every request. Without its token breakdown, a text-only rate is misleading.
    if sum(prompts.values()) != prompt_tokens or sum(cached.values()) != cached_tokens:
        return result(None)
    cost = output_tokens * float(price["output"])
    for modality, tokens in prompts.items():
        audio = modality == "AUDIO"
        rate = price.get("input_audio" if audio else "input")
        cached_rate = price.get("input_cached_audio" if audio else "input_cached")
        cached_count = cached.get(modality, 0)
        if rate is None or cached_count > tokens or (cached_count and cached_rate is None):
            return result(None)
        cost += (tokens - cached_count) * float(rate) + cached_count * float(cached_rate or 0)
    return result(cost / 1_000_000)


def combine_usage_costs(costs: list[UsageCost]) -> UsageCost:
    """Sum usage and cost across chunked transcription requests."""
    return UsageCost(
        prompt_tokens=sum(cost.prompt_tokens for cost in costs),
        output_tokens=sum(cost.output_tokens for cost in costs),
        total_tokens=sum(cost.total_tokens for cost in costs),
        cost_usd=sum_costs([cost.cost_usd for cost in costs]),
        audio_tokens=sum(cost.audio_tokens for cost in costs),
        cached_audio_tokens=sum(cost.cached_audio_tokens for cost in costs),
        cached_tokens=sum(cost.cached_tokens for cost in costs),
        thought_tokens=sum(cost.thought_tokens for cost in costs),
    )


def chunk_cache_path(
    cache_dir: Path,
    audio_path: Path,
    window: tuple[float, float],
    chunk_index: int,
    chunk_count: int,
    model: str,
    system_prompt: str,
    user_prompt: str | None,
) -> Path:
    """Return the cache path for one exact chunk transcription request."""
    stat = audio_path.stat()
    cache_key = json.dumps(
        {
            "audio": str(audio_path.resolve()),
            "size": stat.st_size,
            "mtime_ns": stat.st_mtime_ns,
            "window": window,
            "chunk_index": chunk_index,
            "chunk_count": chunk_count,
            "model": model,
            "system_prompt": system_prompt,
            "user_prompt": user_prompt,
            **({"generation_settings": generation_settings(model)} if generation_settings(model) else {}),
        },
        sort_keys=True,
    ).encode()
    return cache_dir / f"chunk-{hashlib.sha256(cache_key).hexdigest()}.json"


def read_chunk_state(cache_path: Path) -> dict[str, Any]:
    """Load exact-request state, including paid attempts and legacy local transcripts."""
    if not cache_path.exists():
        return {"attempts": []}
    try:
        state = json.loads(cache_path.read_text(encoding="utf-8"))
        if not isinstance(state, dict) or not isinstance(state.get("transcript"), str):
            raise TypeError("transcript must be text")
        if "version" not in state:
            # Legacy caches have no billing provenance. Preserve usable text without claiming zero cost.
            state.update(raw_transcript=state["transcript"], status="received", attempts=[{"usage": None, "legacy": True}])
        else:
            if state.get("version") != 2 or not isinstance(state.get("raw_transcript"), str) or not isinstance(state.get("attempts"), list):
                raise TypeError("expected version 2 raw text and attempt list")
            for attempt in state["attempts"]:
                usage = attempt["usage"]
                if usage is not None and (not isinstance(usage, dict) or "cost_usd" not in usage):
                    raise TypeError("attempt usage must include cost_usd or be null")
        return state
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise RuntimeError(f"Invalid chunk cache {cache_path}: {exc}. Move this file aside and rerun.") from exc


def read_cached_chunk(cache_path: Path) -> TranscriptionResult | None:
    """Return usable raw chunk material with zero new API usage."""
    state = read_chunk_state(cache_path)
    if state.get("status") not in {"complete", "received", "needs_review"}:
        return None
    return TranscriptionResult(state["raw_transcript"], UsageCost(0, 0, 0, 0.0), error=state.get("error"))


def write_chunk_state(cache_path: Path, state: dict[str, Any]) -> None:
    """Raw responses are durable before timestamp processing or note publication."""
    atomic_write(cache_path, json.dumps(state, ensure_ascii=False))
    if RUN_DIR and state.get("status") == "received":
        receipt = RUN_DIR / f"{cache_path.stem}-attempt{len(state['attempts'])}-{uuid.uuid4().hex[:8]}.json"
        atomic_write(receipt, json.dumps(state, ensure_ascii=False))
        append_run(None, "receipt_saved", path=str(receipt), cache=str(cache_path))


@lru_cache(maxsize=1)
def load_genai() -> Any:
    """Import Gemini only on paths that need the API client."""
    from google import genai

    return genai


def build_client() -> Any:
    """Create a Gemini client from GEMINI_API_KEY loaded via dotenv."""
    load_environment()
    api_key = os.environ.get("GEMINI_API_KEY")
    if not api_key:
        raise RuntimeError("GEMINI_API_KEY is not set. Set it in the environment, current .env, or script-directory .env.")
    genai = load_genai()
    return genai.Client(api_key=api_key)


def probe_audio_duration(audio_path: Path) -> float:
    """Return the audio duration in seconds using ffprobe."""
    started = time.monotonic()
    append_run(None, "probe_start", audio=str(audio_path))
    try:
        result = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-show_entries",
                "format=duration",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(audio_path),
            ],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise RuntimeError(f"ffprobe failed for {audio_path.name}: {exc}") from exc
    append_run(None, "probe_complete", audio=str(audio_path), returncode=result.returncode,
        stdout=result.stdout, stderr=result.stderr, elapsed_seconds=time.monotonic() - started)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"ffprobe exited {result.returncode}"
        raise RuntimeError(f"ffprobe failed for {audio_path.name}: {detail}")
    try:
        duration = float(result.stdout.strip())
    except ValueError as exc:
        raise RuntimeError(f"ffprobe returned invalid duration for {audio_path.name}") from exc
    if duration <= 0:
        raise RuntimeError(f"ffprobe returned non-positive duration for {audio_path.name}")
    return duration


def build_chunk_windows(
    duration_seconds: float, chunk_seconds: float, overlap_seconds: float = CHUNK_OVERLAP_SECONDS
) -> list[tuple[float, float]]:
    """Return human-friendly `(start, length)` windows with 1-second overlap between chunks."""
    if chunk_seconds <= 0:
        raise ValueError("chunk_seconds must be positive.")
    if overlap_seconds >= chunk_seconds:
        raise ValueError("overlap_seconds must be smaller than chunk_seconds.")
    # Opus padding can put a recording milliseconds past a nominal boundary. Absorb
    # at most the overlap allowance into the preceding chunk, retaining every sample.
    effective_duration = max(0.0, duration_seconds - overlap_seconds)
    if effective_duration <= chunk_seconds:
        return [(0.0, duration_seconds)]

    chunk_count = math.ceil(effective_duration / chunk_seconds)
    candidate_chunk_seconds = sorted(
        {
            chunk_seconds,
            *(
                minutes * 60.0
                for minutes in FRIENDLY_CHUNK_MINUTES
                if overlap_seconds < minutes * 60.0 <= chunk_seconds
            ),
        }
    )
    nominal_chunk_seconds = chunk_seconds
    for candidate in candidate_chunk_seconds:
        if math.ceil(effective_duration / candidate) == chunk_count:
            nominal_chunk_seconds = candidate
            break

    windows: list[tuple[float, float]] = []
    start = 0.0
    while start < duration_seconds:
        end = min(start + nominal_chunk_seconds, duration_seconds)
        if duration_seconds - end <= overlap_seconds:
            end = duration_seconds
        window_start = 0.0 if not windows else max(0.0, start - overlap_seconds)
        windows.append((window_start, end - window_start))
        start = end
    return windows


def split_audio_chunks(
    audio_path: Path,
    temp_dir: Path,
    windows: list[tuple[float, float]],
) -> list[Path]:
    """Split a long audio file into overlapping chunks with ffmpeg."""
    if len(windows) == 1:
        return [audio_path]

    chunk_paths: list[Path] = []
    for index, (start, length) in enumerate(windows, start=1):
        chunk_path = temp_dir / f"{audio_path.stem}.part{index:03d}.opus"
        started = time.monotonic()
        append_run(None, "split_start", audio=str(audio_path), chunk=index, window=(start, length), output=str(chunk_path))
        try:
            result = subprocess.run(
                [
                    "ffmpeg",
                    "-y",
                    "-hide_banner",
                    "-loglevel",
                    "error",
                    "-ss",
                    f"{start:.3f}",
                    "-t",
                    f"{length:.3f}",
                    "-i",
                    str(audio_path),
                    "-vn",
                    "-c:a",
                    "libopus",
                    "-b:a",
                    "64k",
                    str(chunk_path),
                ],
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError as exc:
            raise RuntimeError(f"ffmpeg failed for {audio_path.name}: {exc}") from exc
        append_run(None, "split_complete", chunk=index, returncode=result.returncode,
            stderr=result.stderr, elapsed_seconds=time.monotonic() - started)
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip() or f"ffmpeg exited {result.returncode}"
            raise RuntimeError(f"ffmpeg failed for {audio_path.name}: {detail}")
        chunk_paths.append(chunk_path)
    return chunk_paths


def plan_audio_chunks(audio_path: Path, chunk_minutes: float) -> tuple[float, list[tuple[float, float]]]:
    """Return the duration and chunk windows that would be used for this audio file."""
    chunk_seconds = chunk_minutes * 60.0
    if chunk_seconds <= CHUNK_OVERLAP_SECONDS:
        raise RuntimeError("--chunk must be greater than 1/60 minute because chunks overlap by 1 second.")
    duration = probe_audio_duration(audio_path)
    try:
        windows = build_chunk_windows(
            duration,
            chunk_seconds,
            overlap_seconds=CHUNK_OVERLAP_SECONDS,
        )
    except ValueError as exc:
        raise RuntimeError(str(exc)) from exc
    return duration, windows


def extract_speaker_labels(transcript: str) -> list[str]:
    """Return speaker labels in first-seen order from transcript lines."""
    speakers: list[str] = []
    seen: set[str] = set()
    for line in transcript.splitlines():
        match = SPEAKER_LINE_RE.match(line.strip())
        if not match:
            continue
        speaker = match.group("speaker").strip()
        if speaker and speaker not in seen:
            speakers.append(speaker)
            seen.add(speaker)
    return speakers


def transcript_tail(transcript: str) -> str:
    """Return a bounded recent transcript excerpt for chunk-to-chunk continuity."""
    lines = [line.rstrip() for line in transcript.splitlines() if line.strip()]
    line_limit, char_limit = context_limits()
    if not line_limit or not char_limit:
        return ""
    tail = "\n".join(lines[-line_limit:])
    if len(tail) <= char_limit:
        return tail
    return tail[-char_limit:].lstrip()


def build_prior_chunk_context(previous_transcripts: list[str]) -> str | None:
    """Return compact context from prior chunks for speaker and topic continuity."""
    if not previous_transcripts:
        return None
    speakers = extract_speaker_labels("\n".join(previous_transcripts))
    speaker_context = ", ".join(speakers) if speakers else "unknown"
    recent_context = transcript_tail(previous_transcripts[-1])
    if not recent_context:
        return None
    return (
        "Context from earlier chunks, for speaker-label continuity and ambiguity resolution only.\n"
        f"Known speaker labels so far: {speaker_context}\n\n"
        "Recent transcript excerpt from the immediately preceding chunk:\n"
        f"{recent_context}\n\n"
        "Use these labels and topics when they match the current audio. "
        "Do not repeat or summarize this context; transcribe only the current audio chunk."
    )


def build_chunk_user_prompt(
    user_prompt: str | None,
    chunk_index: int,
    chunk_count: int,
    prior_chunk_context: str | None = None,
) -> str:
    """Add chunk context so Gemini knows this audio is only one part of the call."""
    chunk_prompt = (
        f"This audio is part {chunk_index}/{chunk_count} of a longer recording. "
        "Transcribe this part faithfully; the final transcript will concatenate all parts in order. "
        "Start timestamps at 00:00 for this audio attachment; do not continue earlier chunks' timestamps."
    )
    prompt_parts = [part for part in (user_prompt, prior_chunk_context, chunk_prompt) if part]
    return "\n\n".join(prompt_parts)


def emit_remaining_warnings(
    audio_path: Path, warnings: tuple[InvalidTranscriptWarning, ...]
) -> None:
    """Log transcript sections that still look invalid after an automatic retry."""
    for warning in warnings:
        typer.echo(
            f"WARNING {audio_path.name}: section {warning.section_index}/{warning.section_count}: "
            f"{warning.reason} Run call {str(audio_path)!r} --patch to re-transcribe it.", err=True,
        )


def transcribe_single_audio(
    audio_path: Path,
    system_prompt: str,
    user_prompt: str | None,
    model: str,
    client: Any,
    pricing: dict[str, dict[str, object]],
) -> TranscriptionResult:
    """Upload one audio file to Gemini and return the transcription text."""
    genai = load_genai()
    started = time.monotonic()
    try:
        append_run(None, "upload_start", audio=str(audio_path), size=audio_path.stat().st_size if RUN_DIR else None)
        uploaded_file = client.files.upload(file=audio_path)
        append_run(None, "upload_complete", file_name=getattr(uploaded_file, "name", None), elapsed_seconds=time.monotonic() - started)
        contents: list[object] = [uploaded_file]
        if user_prompt:
            contents = [user_prompt, uploaded_file]
        chat = client.chats.create(
            model=model,
            config=genai.types.GenerateContentConfig(system_instruction=system_prompt, **generation_settings(model)),
        )
        response = chat.send_message(contents)
    except genai.errors.APIError as exc:
        code = getattr(exc, "code", None)
        action = {
            400: "Check the audio format, prompt and --model.",
            401: "Check GEMINI_API_KEY in the environment and .env.",
            403: "Check the API key's project permissions and model access.",
            404: "Check --model and whether the uploaded file is still available.",
            429: "Check Gemini quota/billing; wait before retrying.",
        }.get(code, "Retry later for service/network errors; use --model if this model keeps failing.")
        raise RuntimeError(f"{exc} Action: {action}") from exc
    usage = calculate_usage_cost(response, requested_model=model, pricing=pricing)
    transcript = (response.text or "").strip()
    candidates = getattr(response, "candidates", None) or []
    reasons = [str(getattr(candidate, "finish_reason", "unknown")) for candidate in candidates]
    raw_usage = getattr(response, "usage_metadata", None)
    try:
        rates = select_price_entry(pricing=pricing, requested_model=model,
            prompt_tokens=usage.prompt_tokens, response_model=getattr(response, "model_version", None))
    except RuntimeError:
        rates = None
    append_run(None, "response", audio=str(audio_path), elapsed_seconds=time.monotonic() - started,
        response_id=getattr(response, "response_id", None), model_version=getattr(response, "model_version", None),
        finish_reasons=reasons, prompt_feedback=str(getattr(response, "prompt_feedback", None)),
        usage=asdict(usage), raw_usage=raw_usage.model_dump(mode="json") if hasattr(raw_usage, "model_dump") else None,
        pricing=rates, transcript_chars=len(transcript))
    bad_finish = next((reason for reason in reasons if reason.rsplit(".", 1)[-1] not in {"STOP", "unknown"}), None)
    error = None
    refused = re.search(r"(?:cannot|can't|unable to) (?:assist|transcribe|process)", transcript, re.IGNORECASE)
    if not transcript or bad_finish or refused:
        error = (
            f"Gemini returned {'empty output' if not transcript else 'incomplete output'}; "
            f"finish_reason={','.join(reasons) or 'no candidates'}; "
            f"prompt_feedback={getattr(response, 'prompt_feedback', None)}. "
            "Check audio/prompt for blocking; if MAX_TOKENS, reduce --chunk; otherwise retry or choose --model."
        )
    return TranscriptionResult(transcript, usage, error=error)


def transcribe_audio(
    audio_path: Path,
    system_prompt: str,
    user_prompt: str | None,
    model: str,
    client: Any,
    pricing: dict[str, dict[str, object]] | None,
    chunk_minutes: float,
    patch_section: int | None = None,
    windows: list[tuple[float, float]] | None = None,
    progress_callback: Callable[[int, int], None] | None = None,
    cache_dir: Path | None = None,
    retry_invalid: bool = True,
    use_cache: bool = True,
    prior_transcripts: list[str] | None = None,
) -> TranscriptionResult:
    """Process known audio windows; keep raw/local chunk state separate from final rendering."""
    if windows is None:
        _, windows = plan_audio_chunks(audio_path, chunk_minutes)
    if patch_section is not None and not 1 <= patch_section <= len(windows):
        raise RuntimeError(f"{audio_path.name} has only {len(windows)} transcript section(s); cannot patch section {patch_section}.")
    if cache_dir is not None:
        cache_dir.mkdir(parents=True, exist_ok=True)
    transcripts: list[TranscriptionResult] = []
    context = list(prior_transcripts or [])
    chunk_costs: list[float | None] = [0.0] * len(windows)
    warnings: list[InvalidTranscriptWarning] = []
    rendered: list[str] = []
    saved_costs: list[float | None] = []
    targets = [patch_section] if patch_section else list(range(1, len(windows) + 1))
    stopped = False
    chunk_paths = None
    with tempfile.TemporaryDirectory(prefix=f"{audio_path.stem}-chunks-") as directory:
        for index in targets:
            if stopped:
                rendered.append("[Transcription pending: rerun call to resume.]")
                continue
            if progress_callback:
                progress_callback(index, len(windows))
            chunk_prompt = build_chunk_user_prompt(user_prompt, index, len(windows),
                build_prior_chunk_context(context)) if len(windows) > 1 else user_prompt
            cache_path = chunk_cache_path(cache_dir, audio_path, windows[index - 1], index, len(windows), model, system_prompt, chunk_prompt) if cache_dir else None
            state = read_chunk_state(cache_path) if cache_path and use_cache else {"attempts": []}
            result = read_cached_chunk(cache_path) if cache_path and use_cache else None
            if patch_section and (state.get("status") == "needs_review" or (result and result.error)):
                result = None
            if result:
                append_run(cache_dir, "cache_hit", audio=str(audio_path), chunk=index, cache=str(cache_path))
            usages: list[UsageCost] = []
            failure = None
            local = ""
            for attempt in range(2 if retry_invalid else 1):
                if result is None:
                    # API construction and pricing are deferred until the first cache miss.
                    if client is None:
                        client = build_client()
                    if pricing is None:
                        pricing = load_google_pricing()
                    if len(windows) == 1:
                        chunk_path = audio_path
                    else:
                        if chunk_paths is None:
                            chunk_paths = split_audio_chunks(audio_path, Path(directory), windows)
                        chunk_path = chunk_paths[index - 1]
                    append_run(cache_dir, "attempt_start", audio=str(audio_path), chunk=index, cache=str(cache_path))
                    try:
                        result = transcribe_single_audio(chunk_path, system_prompt=system_prompt,
                            user_prompt=chunk_prompt, model=model, client=client, pricing=pricing)
                    except Exception as exc:
                        if not isinstance(exc, (RuntimeError, OSError)):
                            traceback.print_exc()
                        state["attempts"].append({"usage": None, "error": str(exc)})
                        state.update(version=2, status="failed", transcript="", raw_transcript="", error=str(exc))
                        if cache_path:
                            write_chunk_state(cache_path, state)
                        append_run(cache_dir, "attempt_error", audio=str(audio_path), chunk=index, usage=None, reason=str(exc))
                        failure = str(exc)
                        usages.append(UsageCost(0, 0, 0, None))
                        break
                    state["attempts"].append({"usage": asdict(result.usage), "error": result.error})
                    state.update(version=2, status="received", transcript=result.transcript,
                        raw_transcript=result.transcript, error=result.error,
                        request={"audio": str(audio_path.resolve()), "size": audio_path.stat().st_size,
                            "mtime_ns": audio_path.stat().st_mtime_ns, "window": windows[index - 1],
                            "chunk_index": index, "chunk_count": len(windows), "model": model,
                            "system_prompt": system_prompt, "user_prompt": chunk_prompt,
                            "generation_settings": generation_settings(model)})
                    if cache_path:
                        write_chunk_state(cache_path, state)
                    append_run(cache_dir, "attempt", audio=str(audio_path), chunk=index, usage=asdict(result.usage), reason=result.error)
                usages.append(result.usage)
                local, timestamp_warning = normalize_chunk(result.transcript, windows[index - 1])
                failure = result.error or timestamp_warning
                valid = looks_like_transcript(local)
                if valid and not failure:
                    state.update(status="complete", transcript=local, error=None)
                    break
                if failure:
                    state.update(status="needs_review" if timestamp_warning and not result.error else "failed", transcript=local, error=result.error)
                    break
                failure = "Model response contains no speaker lines. Check the saved raw response/prompt or run --patch."
                if attempt == 0 and retry_invalid:
                    typer.echo(f"WARNING {audio_path.name}: retrying section {index}/{len(windows)}: {failure}", err=True)
                    result = None
                    if progress_callback:
                        progress_callback(index, len(windows))
                else:
                    state.update(status="failed", transcript=local, error=failure)
            if cache_path:
                write_chunk_state(cache_path, state)
            costs = [item["usage"]["cost_usd"] if item.get("usage") else None for item in state["attempts"]]
            chunk_costs[index - 1] = sum_costs(costs)
            saved_costs.append(chunk_costs[index - 1])
            usage = combine_usage_costs(usages)
            transcripts.append(TranscriptionResult(local, usage))
            context.append(local)
            if failure:
                warnings.append(InvalidTranscriptWarning(index, len(windows), count_matching_transcript_lines(local), failure))
                # Never alter ambiguous timestamps or conceal failed text; only explicit patches re-request it.
                rendered.append(local or "[Transcription failed: no usable text; rerun call or use --patch.]")
                stopped = True
            else:
                rendered.append(render_chunk_timestamps(local, windows[index - 1][0]))
            append_run(cache_dir, "chunk", audio=str(audio_path), chunk=index, status=state.get("status"),
                window=windows[index - 1], timestamp_basis="local", cache=str(cache_path), reason=failure)
    return TranscriptionResult(TRANSCRIPT_PART_SEPARATOR.join(rendered),
        combine_usage_costs([part.usage for part in transcripts]), tuple(warnings), saved_cost_usd=sum_costs(saved_costs), chunk_costs=tuple(chunk_costs))


def note_metadata(markdown: str) -> dict[str, Any]:
    """Read metadata without round-tripping unrelated YAML during writes."""
    import yaml

    match = FRONTMATTER_RE.match(markdown)
    value = yaml.safe_load(match["body"]) if match else {}
    return value if isinstance(value, dict) else {}


def process_audio(
    audio: str,
    user_prompt: str | None,
    force: bool,
    patch: bool,
    model: str,
    chunk_minutes: float,
    out_dir: Path,
    system_prompt_file: Path,
    dry_run: bool,
) -> None:
    """Transcribe or resume a recording, then publish one atomic cumulative-timestamp note."""
    audio_path = resolve_audio_path(audio, DEFAULT_INPUT_DIR)
    output_path = out_dir / f"{audio_path.stem}.md"
    had_output, existing_markdown, _ = read_existing_note(output_path)
    metadata = note_metadata(existing_markdown)
    primary_complete = has_transcript_content(existing_markdown) and metadata.get("transcription_status") != "incomplete"
    candidate_path = output_path.with_suffix(".incomplete.md")
    recovering_replacement = False
    if candidate_path.exists():
        _, candidate, _ = read_existing_note(candidate_path)
        candidate_metadata = note_metadata(candidate)
        identity = {"path": str(audio_path.resolve()), "size": audio_path.stat().st_size, "mtime_ns": audio_path.stat().st_mtime_ns}
        owned = candidate_metadata.get("replacement_for") == str(output_path.resolve())
        if force and primary_complete and not owned:
            raise RuntimeError(f"Move or rename {candidate_path} before --force; it is not a call replacement and must not be overwritten.")
        if not force and owned and candidate_metadata.get("transcription_status") == "incomplete" and candidate_metadata.get("audio_source") == identity:
            if output_path.exists() and output_path.stat().st_mtime_ns > candidate_path.stat().st_mtime_ns:
                typer.echo(f"WARNING preserved older replacement {candidate_path.name}; {output_path.name} is newer. Review the candidate manually.", err=True)
            else:
                existing_markdown, metadata = candidate, candidate_metadata
                recovering_replacement = True
    stored_prompt = extract_prompt_metadata(existing_markdown)
    cleaned_prompt = user_prompt.strip() if user_prompt and user_prompt.strip() else None
    has_transcript = has_transcript_content(existing_markdown)
    incomplete = metadata.get("transcription_status") == "incomplete"
    identity = {"path": str(audio_path.resolve()), "size": audio_path.stat().st_size, "mtime_ns": audio_path.stat().st_mtime_ns}
    source_changed = bool(metadata.get("audio_source") and metadata["audio_source"] != identity)
    if patch and not has_transcript:
        raise RuntimeError(f"{output_path.name}: no transcript section to patch. Run without --patch.")
    if not patch and has_transcript and not incomplete and not source_changed and not force:
        if cleaned_prompt is None or cleaned_prompt == stored_prompt:
            typer.echo(f"Already transcribed: {output_path.name} (use --force to re-transcribe)")
        elif dry_run:
            typer.echo(f"dry-run update prompt metadata: {output_path.name}")
        else:
            preflight_write(output_path)
            atomic_write(output_path, set_prompt_metadata(existing_markdown, cleaned_prompt))
            typer.echo(f"updated prompt metadata: {output_path.name}")
        return

    if patch:
        targets = sorted(set(find_invalid_transcript_sections(existing_markdown)) | set(metadata.get("failed_chunks", [])))
        if not targets:
            typer.echo(f"No invalid transcript sections found in {output_path.name}")
            return
    duration, windows = plan_audio_chunks(audio_path, chunk_minutes)
    if patch:
        if metadata.get("audio_source") and metadata["audio_source"] != identity:
            raise RuntimeError("Audio source changed since this note was created. Use --force instead of --patch.")
        if metadata.get("audio_chunks"):
            windows = [tuple(window) for window in metadata["audio_chunks"]]
        parts = split_transcript_parts(TRANSCRIPT_SECTION_RE.search(existing_markdown)["body"])
        if len(parts) != len(windows):
            raise RuntimeError(f"Note has {len(parts)} chunks but audio plan has {len(windows)}. Check --chunk or use --force; no API request made.")
        if any(not isinstance(section, int) or not 1 <= section <= len(windows) for section in targets):
            raise RuntimeError("Note failed_chunks metadata does not match its audio chunks. Repair that metadata or use --force; no API request made.")
        costs = metadata.get("chunk_costs")
        if costs is not None and (not isinstance(costs, list) or len(costs) != len(windows)):
            raise RuntimeError("Note chunk_costs metadata does not match its audio chunks. Repair that metadata or use --force; no API request made.")
    if dry_run:
        action = "force re-transcribe" if force else ("resume" if incomplete else "update" if had_output else "create")
        typer.echo(f"dry-run {action} {audio_path.name} -> {output_path.name} duration={duration:.1f}s chunks={len(windows)}")
        return

    # Verify local prerequisites before credentials, pricing fetches or paid requests.
    timestamp_tools()  # Required sibling module must be available before paid requests.
    prompts = resolve_prompts(load_system_prompt(system_prompt_file), stored_prompt, cleaned_prompt)
    settings = generation_settings(model)
    context_limits()
    if len(windows) > 1 and shutil.which("ffmpeg") is None:
        raise RuntimeError("ffmpeg is missing. Install ffmpeg before transcribing chunked recordings.")
    cache_dir = Path(os.environ.get("TRANSCRIBE_CALLS_CACHE_DIR", DEFAULT_CACHE_DIR))
    preflight_write(output_path)
    if (force or recovering_replacement) and primary_complete:
        preflight_write(candidate_path)
    preflight_write(cache_dir / "run.jsonl")
    append_run(cache_dir, "start", audio=str(audio_path), output=str(output_path), source=identity,
        windows=windows, model=model, generation_settings=settings, force=force, patch=patch,
        prompt_sha256=hashlib.sha256(prompts.system_prompt.encode()).hexdigest(), prompt_file=str(system_prompt_file))

    def progress(index: int, count: int) -> None:
        if count > 1:
            typer.echo(f"[{index}/{count}] transcribing {audio_path.name}")

    results: list[TranscriptionResult] = []
    published_chunk_costs = list(metadata.get("chunk_costs", [None] * len(windows)))
    legacy_review: set[int] = set()
    updated = existing_markdown
    if patch:
        if not metadata.get("timestamp_basis"):
            # Existing notes may already have been timestamped; preserve the legacy idempotence guard.
            legacy = timestamp_tools().update_markdown(updated, chunk_starts=[round(window[0]) for window in windows])
            updated = legacy.text
            for warning in legacy.warnings:
                location = re.match(r"chunk (\d+)", warning)
                if location and int(location[1]) not in targets:
                    legacy_review.add(int(location[1]))
                typer.echo(f"WARNING {audio_path.name}: {warning}", err=True)
        for section in targets:
            earlier = split_transcript_parts(TRANSCRIPT_SECTION_RE.search(updated)["body"])[:section - 1]
            if metadata.get("timestamp_basis"):
                earlier = [timestamp_tools().shift_chunk(part, -round(windows[index][0]))[0] for index, part in enumerate(earlier)]
            result = transcribe_audio(audio_path, prompts.system_prompt, prompts.user_prompt, model, None, None,
                chunk_minutes, patch_section=section, windows=windows, progress_callback=progress,
                cache_dir=cache_dir, use_cache=True, retry_invalid=False, prior_transcripts=earlier)
            results.append(result)
            published_chunk_costs[section - 1] = result.chunk_costs[section - 1]
            updated = patch_transcript_section(updated, section, result.transcript, prompt=prompts.note_prompt)
            if result.warnings:
                break
    else:
        result = transcribe_audio(audio_path, prompts.system_prompt, prompts.user_prompt, model, None, None,
            chunk_minutes, windows=windows, progress_callback=progress, cache_dir=cache_dir, use_cache=not force)
        results.append(result)
        updated = upsert_transcript_section(updated, audio_path.stem, result.transcript, prompt=prompts.note_prompt)

    usage = combine_usage_costs([result.usage for result in results])
    cost_text = "unknown" if usage.cost_usd is None else f"${usage.cost_usd:.6f}"
    if usage.cost_usd is None:
        typer.echo("WARNING cost is unknown: the response lacks modality/usage data, pricing, or a failed request has no billing response. See run.jsonl.", err=True)
    typer.echo(f"tokens={usage.total_tokens} cost={cost_text} total_cost={cost_text}")
    warnings = tuple(warning for result in results for warning in result.warnings)
    emit_remaining_warnings(audio_path, warnings)
    failed = find_invalid_transcript_sections(updated)
    failed = sorted(set(failed) | legacy_review | {warning.section_index for warning in warnings})
    if patch:
        successful = {section for section, result in zip(targets, results) if not result.warnings}
        failed = sorted(set(failed) | (set(metadata.get("failed_chunks", [])) - successful))
        previous_cost = metadata.get("cost")
        historical_cost = float(previous_cost) if isinstance(previous_cost, (int, float)) else None
        saved_cost = sum_costs(published_chunk_costs) if metadata.get("chunk_costs") else sum_costs([historical_cost, usage.cost_usd])
    else:
        saved_cost = results[0].saved_cost_usd
        published_chunk_costs = list(results[0].chunk_costs)
    updated = set_model_cost_metadata(updated, model, saved_cost)
    updated = set_frontmatter_fields(updated, {
        "transcription_status": "incomplete" if failed else "complete",
        "timestamp_basis": "mixed" if failed else "cumulative",
        "audio_source": json.dumps(identity), "audio_chunks": json.dumps(windows),
        "failed_chunks": json.dumps(failed), "chunk_costs": json.dumps(published_chunk_costs),
    }, prepend=False)
    if (force or recovering_replacement) and primary_complete and failed:
        updated = set_frontmatter_fields(updated, {"replacement_for": json.dumps(str(output_path.resolve()))}, prepend=False)
        output_path = output_path.with_suffix(".incomplete.md")
    atomic_write(output_path, updated)
    if recovering_replacement and not failed:
        candidate_path.unlink()  # Its full contents have just been promoted to the primary note.
        typer.echo(f"promoted and removed replacement candidate: {candidate_path.name}")
    append_run(cache_dir, "saved", audio=str(audio_path), output=str(output_path), status="incomplete" if failed else "complete",
        usage=asdict(usage), saved_cost_usd=saved_cost, failed_chunks=failed)
    if failed:
        raise RuntimeError(f"Saved incomplete transcript {output_path}; failed/pending sections {failed}. Rerun to resume, or use --patch for timestamp review.")
    if patch:
        typer.echo(f"patched section(s) {','.join(str(section) for section in targets)}: {output_path.name}")
    else:
        typer.echo(f"{'updated' if had_output else 'created'} {output_path.name}")


@app.command(help=__doc__, context_settings={"allow_extra_args": False, "ignore_unknown_options": False})
def main(
    audio: list[str] | None = typer.Argument(
        None,
        help=(
            f"Audio file path(s), or case-insensitive substring(s) of filenames in "
            f"{DEFAULT_INPUT_DIR} (most recent match wins). Omit with --list-changes."
        ),
    ),
    user_prompt: str | None = typer.Option(
        None, "--prompt", help="Additional user prompt sent alongside the audio attachment."
    ),
    force: bool = typer.Option(
        False, "--force", help="Re-transcribe even if the note already has a transcript."
    ),
    patch: bool = typer.Option(
        False,
        "--patch",
        help="Detect invalid transcript sections in the existing note and re-transcribe just those.",
    ),
    model: str = typer.Option(
        DEFAULT_MODEL, "--model", envvar="TRANSCRIBE_CALLS_MODEL", help="Gemini model to use for transcription."
    ),
    chunk_minutes: float = typer.Option(
        DEFAULT_CHUNK_MINUTES,
        "--chunk",
        min=0.01,
        help="Chunk size in minutes for splitting long audio before transcription.",
    ),
    out_dir: Path = typer.Option(
        DEFAULT_OUTPUT_DIR, "--out", help="Folder for the transcript Markdown file."
    ),
    system_prompt_file: Path = typer.Option(
        DEFAULT_PROMPT_FILE,
        "--system-prompt",
        help="Markdown file containing the system prompt or first fenced prompt.",
    ),
    dry_run: bool = typer.Option(
        False,
        "--dry-run",
        help="Show the chunk plan without Gemini calls or transcript/cache writes; diagnostic run logs are saved.",
    ),
    list_changes: bool = typer.Option(
        False,
        "--list-changes",
        help=(
            f"List create/update actions as TSV for every audio file in {DEFAULT_INPUT_DIR} "
            "without a transcript yet, without probing audio or changing notes/cached responses. Saves run logs; takes no AUDIO argument."
        ),
    ),
) -> None:
    """Transcribe one or more call recordings into Markdown notes."""
    if out_dir.exists() and not out_dir.is_dir():
        raise typer.BadParameter(f"Output path is not a directory: {out_dir}")
    if list_changes:
        if audio is not None:
            raise typer.BadParameter("--list-changes takes no AUDIO argument.")
        emit_change_list(list_audio_files(DEFAULT_INPUT_DIR), out_dir)
        return
    if audio is None:
        raise typer.BadParameter("Missing argument 'AUDIO'.")
    if system_prompt_file.suffix.lower() != ".md":
        raise typer.BadParameter(f"Prompt file must be Markdown: {system_prompt_file}")
    if patch and force:
        raise typer.BadParameter("--patch cannot be used with --force.")
    if patch and dry_run:
        raise typer.BadParameter("--patch cannot be used with --dry-run.")

    for audio_arg in audio:
        try:
            process_audio(
                audio_arg,
                user_prompt=user_prompt,
                force=force,
                patch=patch,
                model=model,
                chunk_minutes=chunk_minutes,
                out_dir=out_dir,
                system_prompt_file=system_prompt_file,
                dry_run=dry_run,
            )
        except (typer.Exit, typer.BadParameter):
            raise
        except Exception as exc:
            if isinstance(exc, PermissionError):
                action = f"Grant write/read access to {exc.filename}; or choose a writable --out/cache directory."
            elif isinstance(exc, FileNotFoundError):
                action = f"Check {exc.filename}; install ffmpeg/ffprobe if the executable is missing."
            elif isinstance(exc, OSError):
                action = f"Check filesystem access/free space for {exc.filename}; choose a writable --out or TRANSCRIBE_CALLS_CACHE_DIR/TRANSCRIBE_CALLS_PRICES_CACHE."
            elif isinstance(exc, RuntimeError):
                action = "Correct the reported cause, then rerun without --force to reuse successful cached chunks."
            elif isinstance(exc, json.JSONDecodeError):
                action = f"Repair malformed JSON near line {exc.lineno}, column {exc.colno}; move the affected cache file aside and rerun."
            else:
                action = "Save this traceback and the command and report the bug; rerun without --force to reuse successful cached chunks."
                traceback.print_exc()
            append_run(None, "error", audio=audio_arg, exception_type=type(exc).__name__, reason=str(exc), action=action)
            typer.echo(f"ERROR {audio_arg}: {type(exc).__name__}: {exc} Action: {action}", err=True)
            raise typer.Exit(1) from exc


if __name__ == "__main__":
    run_cli()
