"""Send a prompt to Claude in your CDP browser or back up local Claude captures.

Examples:
  claudecli "Summarize this"
  claudecli --file report.pdf --save ./answer.md "Analyze this"
  cat prompt.md | claudecli --no-submit
  claudecli backup --dry-run -v --format jsonl | jaq .
"""
